// Circuit — V1 data model
// Conceptual source: Circuit PRD, section 14 (Data Model)
// https://claude.ai/code/artifact/f568d35d-e93e-4205-9242-6a70c3a99d90
//
// This is a real schema derived from that conceptual model, built for task
// P0-1 in the Circuit Build Plan:
// https://claude.ai/code/artifact/a4a8a76e-68a5-4d50-b710-cda50106af8b

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  LIVE
  COMPLETE
  CANCELLED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WITHDRAWN
  REFUNDED
}

enum MatchStatus {
  UPCOMING
  NEEDS_RESULT
  DISPUTED
  COMPLETE
}

/// MAIN = the one lobby of an ungrouped tournament.
enum LobbyStage {
  MAIN
  GROUP
  FINAL
}

enum LobbyRoundStatus {
  PENDING
  POSTED
}

/// A player's objection to a posted lobby round: the organizer answers
/// first (RESOLVED = corrected, DISMISSED = results stand); the player
/// can escalate to Circuit staff, whose answer is final.
enum LobbyFlagStatus {
  OPEN
  ESCALATED
  RESOLVED
  DISMISSED
}

/// The life of one repeated-pair flag: OPEN until a person has looked at it,
/// then either DISMISSED (nothing here) or ACTIONED (something was done about
/// it — a suspension, a wallet freeze, a conversation). Deliberately not
/// ReportStatus's four: a flag has no "reviewed but not decided" state, and no
/// separate ESCALATED step because a flag is already in front of staff the
/// moment it exists.
enum StakePatternStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum DisputeStatus {
  OPEN
  ORGANIZER_REVIEW
  ESCALATED
  RESOLVED
  VOID
}

enum EscrowType {
  ENTRY_FEE
  REFUND
  PRIZE_PAYOUT
  /// One row per player, created the moment their side of a Battle's
  /// stake is locked (creator at Battle creation, accepter at accept).
  STAKE
  /// Created once, to the match winner, for the full pot (both players'
  /// STAKE amounts) when a staked Battle's match completes.
  STAKE_PAYOUT
  /// Circuit's own cut, carved out of an entry fee the moment it's
  /// confirmed — see PlatformSetting.platformFeeBps. Recorded alongside
  /// the ENTRY_FEE row for the same registration, same amount charged to
  /// the player either way: this doesn't change what anyone pays, only
  /// how the money that already arrived is allocated in the ledger.
  PLATFORM_FEE
  /// The organizer's own cut of an entry fee — entryFee minus PLATFORM_FEE,
  /// in full (no separate configurable rate; the platform fee is the only
  /// cut taken). Recorded PENDING alongside ENTRY_FEE/PLATFORM_FEE at
  /// confirmation time, then flipped to COMPLETE by settleOrganizerRevenue
  /// once the tournament's settlement window passes with no open dispute
  /// or funds freeze — see Tournament.completedAt and
  /// PlatformSetting.organizerRevenueSettlementHours. Unlike PLATFORM_FEE,
  /// `userId` is set (the organizer) so the settlement sweep knows whose
  /// wallet to credit.
  ORGANIZER_REVENUE
}

enum EscrowStatus {
  PENDING
  COMPLETE
  FAILED
}

enum PaymentProviderName {
  PAYSTACK
  FLUTTERWAVE
  BACHS
}

enum BattleVisibility {
  /// Visible to everyone on the open Challenge board.
  OPEN
  /// Visible only to one named player (`Battle.targetUserId`).
  TARGETED
  /// Visible only to the creator's accepted friends (`Friendship`) — any
  /// of them can accept, not just one. See `src/lib/friends.ts`.
  FRIENDS
}

enum BattleStatus {
  OPEN
  ACCEPTED
  CANCELLED
  COMPLETE
  /// Nobody accepted before `Battle.expiresAt`; any stake went back to the creator.
  EXPIRED
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Core identity. Maps to ACC-1..ACC-6.
/// Account creation is deferred (D4) — a User row is only created at
/// register-with-intent-to-pay, Battle accept, or payout claim.
model User {
  /// Bumped on password change/reset and on suspension. Session tokens carry the value they were
  /// issued with, so bumping it signs out every other device holding an older token.
  sessionVersion      Int                   @default(0)
  id                  String                @id @default(cuid())
  displayName         String
  handle              String                @unique
  emailOrPhone        String                @unique
  passwordHash        String?
  avatarUrl           String?
  /// Short public profile tagline (ACC-6 profile edit) — free text,
  /// entirely optional, never used anywhere else in the app.
  bio                 String?
  /// Free-text city/state/country — same optional-profile-field convention
  /// as bio. Not shown anywhere yet; exists so Player Discovery's region
  /// filter (a later phase) has real values to query instead of starting
  /// from zero once that filter ships.
  region              String?
  /// Self-curated list of games shown on the public profile — player-typed
  /// free text, not derived from real match history and NOT sourced from
  /// the `Game` catalog the way Tournament.game/Battle.game are: a
  /// player's "games I play" is a personal claim, not a real competition,
  /// so it isn't constrained to what organizers can actually host.
  favoriteGames       String[]              @default([])
  dateOfBirth         DateTime?
  ageVerified         Boolean               @default(false)
  /// P0-7: linked payout destination — what REG-6's payout actually pays out to.
  payoutMethodRef     String?
  /// Real, validated email — separate from `emailOrPhone` above, which may
  /// hold a phone number instead and was never format-checked at signup.
  /// Only ever set through Account Settings' own validation. Nullable:
  /// nobody is required to add one, they just don't get the email side of
  /// notifyNewContent below until they do.
  email               String?               @unique
  /// Set when they click the link in a verification email (or sign up
  /// with Google, which verifies the address). Cleared if the email changes.
  emailVerifiedAt     DateTime?
  /// Finished (or skipped) the post-signup /welcome flow.
  onboardedAt         DateTime?
  /// Nigerian mobile in +234… form (src/lib/phone.ts). Optional at signup;
  /// not SMS-verified. Can be used to log in when present.
  phone               String?               @unique
  /// ISO 3166-1 alpha-2 code picked at signup (src/lib/countries.ts). Null
  /// for accounts created before the country field existed.
  country             String?
  /// When they ticked "I agree to the Terms and Privacy Policy" at signup.
  /// Null for accounts created before the checkbox existed.
  termsAcceptedAt     DateTime?
  /// Privacy: false hides them from search and Discover (their profile is
  /// still reachable by direct link). See src/lib/privacy.ts.
  searchable          Boolean               @default(true)
  /// SEO: true lets search engines index their public profile (opt-in; never for under-18s or suspended accounts).
  /// See src/lib/profileSeo.ts.
  searchEngineIndexable Boolean             @default(false)
  /// Privacy: who may send them a direct challenge (a challenge aimed at
  /// them, or a Quick Match request).
  directChallenges    DirectChallengePolicy @default(ANYONE)
  /// Set when they asked for their account to be deleted. Staff process it
  /// by hand (money and records have to be settled first); null otherwise.
  deletionRequestedAt DateTime?
  /// Single opt-out switch for "new tournament/challenge" broadcast
  /// announcements (email + push only — in-app notifications are always-on
  /// regardless, per InAppChannel's own comment in notifications.ts).
  /// Defaults to on so a real audience exists for the feature at all.
  notifyNewContent    Boolean               @default(true)
  /// Set once this user's browser subscribes via OneSignal. Not the
  /// broadcast targeting mechanism (that uses OneSignal's own "Subscribed
  /// Users" segment) — kept mainly for future debugging/visibility.
  oneSignalPlayerId   String?
  /// P6-1/P6-2/P6-4: Circuit staff access — dispute-queue escalation
  /// ruling, account suspension. No self-serve grant path exists yet;
  /// setting this currently means a direct DB write, which is fine at V1's
  /// staffing size but is itself worth flagging as a gap.
  isStaff             Boolean               @default(false)
  /// Only meaningful when `isStaff` is true — which of the two fixed
  /// admin roles this staff account has. Null for an ordinary player.
  /// See `AdminRole`'s own comment for what each role can actually do.
  adminRole           AdminRole?
  /// P6-4/TRU-4: blocks registering, paying, or accepting Battles —
  /// checked at those specific write actions, never at login or browsing
  /// (same "don't touch the read path" discipline as the age gate, TRU-5).
  isSuspended         Boolean               @default(false)
  suspensionReason    String?
  /// Self-exclusion / cool-off — the player asked to be barred from staking,
  /// and this is when that bar lifts. The staff-imposed counterpart of
  /// `isSuspended` above; nothing but the player sets it, and only staff can
  /// end it early. Enforced in `lockStake` (src/lib/stakes.ts), so it stops
  /// locking a stake and nothing else: free Battles, tournaments and browsing
  /// are untouched, because staking is the only gambling-shaped thing Circuit
  /// has (docs/circuit-strategy.md §10). An absolute timestamp rather than a
  /// duration, because a cool-off whose end nobody can name is one a player
  /// can talk themselves out of; expired means not excluded, so no cleanup
  /// job is needed to end one. Players may push it further out but never pull
  /// it in — an early lift is a staff action, and `logAdminAction` records it.
  selfExcludedUntil   DateTime?
  /// When this run of exclusion began. Kept separately from `updatedAt`
  /// because an extension overwrites that, and "on a break since X" is the
  /// fact worth showing — including after an extension moves the end date.
  selfExcludedAt      DateTime?
  /// Real, spendable Circuit balance (kobo) — funded via Fund Wallet,
  /// spent on entry fees, cashed out via Withdraw. The authoritative
  /// running total; `WalletTransaction` below is the immutable ledger
  /// that justifies it, kept in sync in the same DB transaction as every
  /// balance change so the two can never drift apart.
  walletBalance       Int                   @default(0)
  /// Quick Match presence (BTL-Q1): refreshed every ~25s by a client
  /// heartbeat while a signed-in tab is open (`PresenceHeartbeat.tsx`) —
  /// "online" for Quick Match eligibility means this timestamp is within
  /// the last ~45-60s. Deliberately not a `lastSeenAt`-at-login field:
  /// this codebase's own Discovery module explicitly avoids fabricating
  /// an "online now" signal from stale login timestamps, so this is a
  /// narrowly-scoped, frequently-refreshed field for Quick Match only,
  /// not a general presence system other features should assume is fresh.
  lastActiveAt        DateTime?
  createdAt           DateTime              @default(now())
  /// V1 audit follow-up (money-relevant models) — walletBalance and the
  /// suspension/staff flags above all mutate after creation with no
  /// signal of when; useful for debugging a balance that looks stale and
  /// for reconciliation, same reasoning as the other money-relevant
  /// models this was added to alongside (WalletTransaction,
  /// EscrowTransaction, Registration, Tournament, Battle).
  updatedAt           DateTime              @updatedAt

  organizerProfile        OrganizerProfile?
  blocking                UserBlock[]              @relation("Blocker")
  blockedBy               UserBlock[]              @relation("Blocked")
  tournamentUpdates       TournamentUpdate[]       @relation("TournamentUpdateAuthor")
  registrations           Registration[]
  matchesAsPlayerA        Match[]                  @relation("MatchPlayerA")
  matchesAsPlayerB        Match[]                  @relation("MatchPlayerB")
  matchesWon              Match[]                  @relation("MatchWinner")
  listings                Listing[]
  marketplaceOrders       Order[]
  battlesCreated          Battle[]                 @relation("BattleCreator")
  battlesTargeted         Battle[]                 @relation("BattleTarget")
  quickMatchesHosted      QuickMatchChallenge[]    @relation("QuickMatchHost")
  quickMatchesAccepted    QuickMatchChallenge[]    @relation("QuickMatchAcceptedBy")
  quickMatchInvites       QuickMatchRecipient[]    @relation("QuickMatchRecipient")
  disputesRaised          Dispute[]                @relation("DisputeRaisedBy")
  notifications           Notification[]
  reportsFiled            Report[]                 @relation("ReportFiledBy")
  reportsReceived         Report[]                 @relation("ReportAgainstUser")
  communityPosts          CommunityPost[]          @relation("CommunityPostAuthor")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  communityMutes          CommunityMute[]          @relation("CommunityMuted")
  communityReportsFiled   CommunityReport[]        @relation("CommunityReportFiledBy")
  communityReportsAgainst CommunityReport[]        @relation("CommunityReportAgainst")
  appeals                 Appeal[]
  eventRsvps              EventRsvp[]
  rosterMemberships       RosterMember[]           @relation("RosterMemberships")
  gameNames               UserGameName[]
  lobbyFlags              LobbyFlag[]              @relation("LobbyFlagsRaised")
  stakePatternFlagsAsA    StakePatternFlag[]       @relation("StakePatternFlagsOnA")
  stakePatternFlagsAsB    StakePatternFlag[]       @relation("StakePatternFlagsOnB")
  stakePatternReviews     StakePatternFlag[]       @relation("StakePatternFlagsReviewed")
  sponsorshipsRecorded    TournamentSponsorship[]  @relation("SponsorshipsRecorded")
  walletTransactions      WalletTransaction[]
  auditLogEntries         AuditLogEntry[]
  friendshipsSent         Friendship[]             @relation("FriendshipRequester")
  friendshipsReceived     Friendship[]             @relation("FriendshipAddressee")
  teamsCaptained          Team[]                   @relation("TeamCaptain")
  teamMemberships         TeamMembership[]
  escrowTransactions      EscrowTransaction[]
  videoLikes              VideoLike[]
  videoSaves              VideoSave[]
  communityMemberships    CommunityMember[]
  ownedCommunities        Community[]              @relation("CommunityOwner")
  communityInvites        CommunityInvite[]        @relation("CommunityInviteCreator")
  communityApplications   CommunityApplication[]   @relation("CommunityApplicant")
  communityBans           CommunityBan[]           @relation("CommunityBanned")
  /// The community whose tag shows next to their name (must be a member).
  featuredCommunityId     String?
  featuredCommunity       Community?               @relation("FeaturedCommunity", fields: [featuredCommunityId], references: [id], onDelete: SetNull)
  messages                Message[]
  messageMentions         MessageMention[]         @relation("MessageMentions")
  messageReactions        MessageReaction[]        @relation("MessageReactions")
  authIdentities          AuthIdentity[]

  @@index([emailOrPhone])
  @@index([lastActiveAt])
  // /api/search's `contains` on displayName and handle (finding #11). The
  // @unique on handle above is a btree, which a leading-wildcard ILIKE
  // cannot use either.
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// The admin dashboard's two fixed roles (no per-permission matrix — a
/// bigger system than a V1 staffing size of "a handful of people"
/// justifies). SUPER_ADMIN can do everything MODERATOR can, plus manage
/// other staff accounts (grant/revoke access, change roles) and toggle
/// platform-wide settings; MODERATOR covers day-to-day moderation
/// (suspend/unsuspend users, cancel tournaments, manage homepage content
/// and the calendar) but can't touch who else has admin access. Checked
/// in each admin API route directly (see e.g. `/api/admin/settings`),
/// not via a separate middleware layer.
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum WalletTransactionType {
  /// A Marketplace purchase paid from the wallet — internal only, no provider
  /// touched. The matching `Order` row carries what was bought.
  MARKETPLACE_DEBIT
  /// A cancelled Marketplace order refunded back into the wallet.
  MARKETPLACE_REFUND
  /// An entry fee that was paid from the wallet, refunded back into it when
  /// the player withdrew or the tournament was cancelled — internal only,
  /// the mirror of ENTRY_FEE_DEBIT. (Card-paid entries refund to the card.)
  ENTRY_FEE_REFUND
  /// Real money in, via Paystack/Flutterwave checkout.
  FUND
  /// Real money out, via Paystack/Flutterwave transfer to payoutMethodRef.
  WITHDRAWAL
  /// A tournament entry fee paid straight from the wallet balance instead
  /// of a fresh external checkout — internal only, no provider touched
  /// for this specific transaction (the money already arrived at some
  /// earlier FUND). A real `EscrowTransaction(type: ENTRY_FEE)` row is
  /// still created alongside this one, same as an externally-paid entry
  /// fee, so tournament-side accounting (dashboard/payouts) sees no
  /// difference in how the fee was funded.
  ENTRY_FEE_DEBIT
  /// A Battle stake locked from the wallet balance — see `EscrowType.STAKE`.
  /// Always wallet-only, same "no provider touched" reasoning as
  /// ENTRY_FEE_DEBIT: a stake can only ever be funded from an existing
  /// wallet balance, never a fresh external checkout.
  STAKE_DEBIT
  /// Any wallet credit that resolves a Battle stake — winning the pot
  /// (`EscrowType.STAKE_PAYOUT`) or getting a stake back from a voided
  /// match (`EscrowType.REFUND`). One wallet-ledger type for both; the
  /// paired `EscrowTransaction.type` is what distinguishes why. Unlike a
  /// tournament prize (paid out externally via `payoutMethodRef`), a
  /// Battle stake always resolves straight back into the wallet — no
  /// organizer/claim flow for a peer-to-peer pot.
  STAKE_CREDIT
  /// A settled `EscrowType.ORGANIZER_REVENUE` row credited to the
  /// organizer's wallet balance by settleOrganizerRevenue() — always
  /// wallet-only, no provider touched (same reasoning as ENTRY_FEE_DEBIT):
  /// this is Circuit crediting an internal ledger allocation, not a fresh
  /// payment. Withdrawing it afterward reuses the existing Withdraw from
  /// Wallet flow unchanged — no separate organizer payout route needed.
  ORGANIZER_REVENUE_CREDIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETE
  FAILED
}

/// The wallet's immutable ledger. `User.walletBalance` is the derived
/// running total; every change to it happens in the same DB transaction
/// as the row here that justifies it.
model WalletTransaction {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  type        WalletTransactionType
  /// Minor currency units (kobo). Always positive — `type` gives direction.
  amount      Int
  /// Null for ENTRY_FEE_DEBIT — no external provider is touched for that
  /// specific transaction.
  provider    PaymentProviderName?
  providerRef String?                 @unique
  status      WalletTransactionStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  /// V1 audit follow-up — `status` flips PENDING→COMPLETE/FAILED after
  /// creation with no record of when, which matters for spotting a
  /// transaction stuck PENDING and for reconciliation against the
  /// provider's own records.
  updatedAt   DateTime                @updatedAt

  @@index([userId, status])
}

/// Forgot-password flow. Only `tokenHash` (SHA-256 of the raw token) is
/// stored — the raw token exists only in the reset link/email, same
/// "never store the secret itself" discipline as `passwordHash` on User.
/// Single-use: `usedAt` is set the moment a reset succeeds, and the reset
/// route rejects any token that's expired, already used, or unknown.
/// A way to sign in to an existing User other than their password —
/// today only Google. One person = one User: an identity always points at
/// an existing account (new Google users get their User created first,
/// then this row), and a Google account can only ever be attached to one
/// User. Adding another provider later is new rows, not a new table.
///
/// No provider tokens are stored — Circuit only needs to know *who* signed
/// in (the verified ID token's claims at login), never to call Google on
/// the user's behalf.
model AuthIdentity {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google"
  provider          String
  /// The provider's stable account id (Google's `sub`), never the email —
  /// emails can change or be recycled.
  providerAccountId String
  /// The provider-verified email at the time of linking, for display only.
  email             String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

/// One-time link proving they own `email` (the address at the time it was
/// sent — a later email change makes it useless). Stored hashed, like
/// password reset tokens.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// 1:1 with User, created automatically on that user's first tournament (ACC-4).
/// Not a separate signup — see D4 and the PRD's Users & Roles section.
model OrganizerProfile {
  userId      String       @id
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean      @default(false)
  tournaments Tournament[]
}

/// Maps to TRN-1..TRN-6.
/// Admin-curated catalog of games organizers can pick from when creating a
/// tournament or challenge (see Tournament.game / Battle.game) — Admin >
/// Games manages these rows. Tournament.game and Battle.game stay plain
/// strings so every existing row and read site keeps working unchanged.
///
/// Configuration-driven competition rules hang off this row:
/// Game → GameMode → GameFormat. Nothing about how a game is played
/// competitively (which modes exist, team sizes, lobby sizes, which
/// tournament structures apply) lives in code — it's all these rows, so a
/// brand-new game needs no code change. See src/lib/gameCatalog.ts.
model Game {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  /// Square logo (upload purpose "game-icon").
  iconUrl     String?
  /// Wide cover art (upload purpose "game-cover") — what GameArtTile shows
  /// for this game everywhere, ahead of the built-in stock photo map.
  coverUrl    String?
  /// Free text, e.g. "Battle Royale", "Sports", "Tactical Shooter".
  category    String?
  /// e.g. ["Mobile", "PC", "PlayStation"]. Free text, admin-entered.
  platforms   String[]  @default([])
  publisher   String?
  /// SEO: the address of the game's public page (/games/<slug>), e.g. "call-of-duty-mobile". Null = derived from the name.
  slug        String?   @unique
  /// SEO: the full name used in page titles when `name` is an abbreviation (name "CODM", seoName "Call of Duty: Mobile").
  seoName     String?
  /// SEO: other names people search for. Old or alternate addresses built from these redirect to the canonical one.
  aliases     String[]  @default([])
  /// Active/inactive — an inactive game is hidden from creation forms.
  enabled     Boolean   @default(true)
  /// Null = draft. Organizers only see games that are both enabled and
  /// published; publishing requires at least one active mode with an
  /// active format (enforced by the publish route).
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  /// DB default only so the column could be added to existing rows.
  updatedAt   DateTime  @default(now()) @updatedAt

  modes       GameMode[]
  communities Community[]
  tournaments Tournament[]
  playerNames UserGameName[]

  @@index([enabled])
}

/// How a mode is actually contested: two sides meeting in a bracket match,
/// or many entries sharing one lobby and scored by placement.
enum CompetitionStyle {
  HEAD_TO_HEAD
  LOBBY
}

enum EntryType {
  INDIVIDUAL
  TEAM
}

/// A way a game is played competitively (Battle Royale, Team Deathmatch,
/// Search & Destroy...). Unlimited per game, admin-ordered.
model GameMode {
  id          String           @id @default(cuid())
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name        String
  description String?
  style       CompetitionStyle @default(HEAD_TO_HEAD)
  /// False = the mode has no separate format layer (Game → Mode →
  /// Competition): it owns exactly one `isDefault` GameFormat holding its
  /// player/team rules, edited inline on the mode. True = admins manage
  /// any number of named formats under it (Solo/Duo/Squad...). Either way
  /// a competition always points at a GameFormat, so nothing downstream
  /// has to special-case the two shapes.
  usesFormats Boolean          @default(true)
  enabled     Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  formats     GameFormat[]
  tournaments Tournament[]

  @@unique([gameId, name])
  @@index([gameId, sortOrder])
}

/// A player/team configuration within a mode (Solo, Duo, Squad, 5v5...).
/// Every field is admin-set — none are implied by the game or mode name.
model GameFormat {
  id                 String    @id @default(cuid())
  modeId             String
  mode               GameMode  @relation(fields: [modeId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  entryType          EntryType @default(INDIVIDUAL)
  /// Players who actually play for one side at a time (1 for individual).
  playersPerTeam     Int       @default(1)
  /// Roster bounds for team entries (substitutes allowed when max >
  /// playersPerTeam). Null = exactly playersPerTeam.
  minRoster          Int?
  maxRoster          Int?
  /// Sides per match/lobby. 2 for head-to-head; null = "multiple" (a
  /// lobby holds as many entries as maxPlayersPerMatch allows).
  teamsPerMatch      Int?
  /// Lobby/match player cap, e.g. 100 for a Battle Royale lobby.
  maxPlayersPerMatch Int?
  /// Competition structures organizers may run this format as — codes
  /// from src/lib/competitionStructures.ts (e.g. "KNOCKOUT").
  structures         String[]  @default([])
  /// Starting rules text offered to organizers for this format.
  defaultRules       String?
  /// The single implicit format of a mode with usesFormats = false.
  /// LOBBY formats: points by finishing place, index 0 = 1st; places past
  /// the end score 0. Empty = the standard table (src/lib/lobbyScoring.ts).
  placementPoints    Int[]     @default([])
  /// LOBBY formats: points per kill.
  killPoints         Int       @default(1)
  isDefault          Boolean   @default(false)
  enabled            Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tournaments Tournament[]

  @@unique([modeId, name])
  @@index([modeId, sortOrder])
}

model Tournament {
  id                  String           @id @default(cuid())
  organizerId         String
  organizer           OrganizerProfile @relation(fields: [organizerId], references: [userId])
  name                String
  /// Free text, not a foreign key to `Game` — see that model's comment.
  /// Populated from an admin-curated `Game.name` list via the creation/
  /// edit form's `<select>`, not hand-typed.
  game                String
  /// V1 is knockout-only (D2). Kept as a string, not an enum, so V2 formats
  /// (round-robin, league) don't require a migration to add.
  format              String           @default("KNOCKOUT")
  /// How many players face off per side of a bracket match — "1v1"
  /// through "5v5". Organizer-set at creation (real match-format research:
  /// e.g. Call of Duty Mobile alone runs 5v5 in ranked multiplayer but
  /// solo/duo in Tournament Mode — team size is a property of the specific
  /// competition, not the game). Kept as a string, not derived from
  /// `game`, for the same reason `game` itself isn't a hard foreign key.
  /// Real limitation, not silently glossed over: this is a descriptive
  /// label only. `Registration` still links exactly one `User` per row —
  /// Circuit has no team/roster model, so a "5v5" tournament still means
  /// five individual people each register solo and coordinate as a team
  /// outside the platform. Bracket matches themselves are always a real
  /// 1-vs-1 `Match` row regardless of teamSize.
  teamSize            String           @default("1v1")
  /// Game catalog link (Admin → Games) and a snapshot of the configuration
  /// chosen at creation — catalog edits later must not change a
  /// competition that's already running. `game`/`teamSize`/`format` stay
  /// filled (name, "Mode · Format" label, structure id) for every reader
  /// that predates the catalog. Null ids = created before the catalog, or
  /// the catalog entry was since deleted (the snapshot still describes it).
  gameId              String?
  gameRef             Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameModeId          String?
  gameMode            GameMode?        @relation(fields: [gameModeId], references: [id], onDelete: SetNull)
  gameFormatId        String?
  gameFormat          GameFormat?      @relation(fields: [gameFormatId], references: [id], onDelete: SetNull)
  modeName            String?
  formatName          String?
  competitionStyle    CompetitionStyle @default(HEAD_TO_HEAD)
  entryType           EntryType        @default(INDIVIDUAL)
  playersPerTeam      Int              @default(1)
  /// TEAM entries: how many players a roster may list (snapshot of the
  /// format's minRoster/maxRoster; null = exactly playersPerTeam).
  minRoster           Int?
  maxRoster           Int?
  /// LOBBY tournaments: how many rounds (games) every entry plays, and
  /// the scoring snapshotted from the format at creation.
  lobbyRounds         Int?
  /// LOBBY tournaments run as groups, then a final (null = one lobby):
  /// how many group lobbies, how many of each qualify, and the final's
  /// rounds. lobbyRounds is then the group stage's rounds.
  lobbyGroups         Int?
  lobbyQualifiers     Int?
  lobbyFinalRounds    Int?
  /// League settings (format LEAGUE only; null otherwise): points for a win,
  /// points for a draw (null = draws aren't allowed in this league), how many
  /// times everyone meets (1 = single, 2 = home and away), and days per matchday.
  leagueWinPoints     Int?
  leagueDrawPoints    Int?
  leagueLegs          Int?
  leagueMatchdayDays  Int?
  placementPoints     Int[]            @default([])
  killPoints          Int              @default(1)
  /// Minor currency units (kobo), never a float. 0 = free tournament.
  entryFee            Int              @default(0)
  prizeAmount         Int?
  prizeText           String?
  /// How prizeAmount is shared: percent per finishing place, index 0 =
  /// 1st (sums to 100). Empty = winner takes all. See src/lib/prizes.ts.
  prizeSplit          Int[]            @default([])
  rulesText           String?
  /// Just a link (Twitch/YouTube/anything) — no embed, no live-status
  /// check. Full streaming integration is a documented V2 item (PRD's
  /// Fraud & Trust backlog note on "live proctoring... bundled with the
  /// streaming build-out"); this is the lightweight V1 slice of it.
  streamUrl           String?
  /// The organizer's own real poster/banner for this specific tournament
  /// — usually an upload (a site-relative `/api/images/<ref>` path, see
  /// src/lib/uploads.ts), or an older/linked external URL. Null falls back to
  /// GameArtTile's generic per-game stock photo/gradient (see that
  /// component's own comment) rather than a broken image.
  posterUrl           String?
  participantCap      Int
  registrationOpenAt  DateTime
  registrationCloseAt DateTime
  startAt             DateTime
  /// A separate timestamp from startAt/registrationCloseAt on purpose —
  /// players who already paid need protection *before* the tournament
  /// even begins, not just once it's live. Computed once at creation
  /// (startAt minus PlatformSetting.cancellationLockHoursBeforeStart at
  /// that moment) and stored concretely, so a later change to that
  /// default doesn't retroactively move an already-set lock point.
  /// Past this timestamp, tournaments/[id]/cancel/route.ts blocks the
  /// organizer specifically — staff can still cancel (an intentional
  /// "only admin/system action" escape hatch, same reasoning as
  /// fundsFrozen). Null on any tournament created before this field
  /// existed — treated as "no lock," same as today's behavior.
  cancellationLockAt  DateTime?
  status              TournamentStatus @default(DRAFT)
  /// Admin financial control (V1 audit's fund-freeze requirement) — set
  /// via POST/DELETE /api/tournaments/[id]/freeze-funds, requireStaff()
  /// gated. Blocks the prize-payout claim and cancel-with-refund routes
  /// while true; who froze it, when, and why lives in AuditLogEntry
  /// (action "tournament.freezeFunds"/"tournament.unfreezeFunds") rather
  /// than duplicating actor/reason/timestamp fields here — same "reuse
  /// the existing audit log" reasoning as every other admin action.
  fundsFrozen         Boolean          @default(false)
  /// Who streams: the tournament, its players, both, or nobody. `streamUrl` below is the tournament's own stream.
  streamMode          StreamMode       @default(NONE)
  streamPlatform      StreamPlatform?
  /// The platform's name when `streamPlatform` is OTHER.
  streamPlatformName  String?
  /// Set when staff review a completed tournament's results and its collected money and approve the payout.
  /// Until then neither the prizes can be claimed nor the organizer's share released (see the admin Payouts page).
  payoutApprovedAt    DateTime?
  payoutApprovedById  String?
  payoutApprovalNote  String?
  /// Set once, the moment this tournament's final bracket match completes
  /// (applyWinnerAdvancement in src/lib/matches.ts) — the anchor
  /// settleOrganizerRevenue() waits PlatformSetting.
  /// organizerRevenueSettlementHours past before crediting that
  /// tournament's PENDING ORGANIZER_REVENUE rows to the organizer's
  /// wallet. Null until then; null forever for a cancelled tournament
  /// (cancellation voids the whole event before it ever reaches this
  /// flip — see tournaments/[id]/cancel/route.ts).
  completedAt         DateTime?
  /// ISO 3166-1 alpha-2 country, taken from the organizer's country when the tournament is created (SEO country pages).
  country             String?
  createdAt           DateTime         @default(now())
  /// V1 audit follow-up — status/fundsFrozen/cancellationLockAt all
  /// mutate after creation; useful for reconciliation and for spotting
  /// what changed and when on a specific tournament during a dispute.
  updatedAt           DateTime         @updatedAt

  registrations   Registration[]
  bracket         Bracket?
  rounds          LobbyRound[]
  matches         Match[]
  escrowTxns      EscrowTransaction[]
  videos          Video[]
  community       Community?
  updates         TournamentUpdate[]
  /// Set when a community hosts this tournament: it shows as that
  /// community's event and is announced there. The organizer must be an
  /// owner or moderator of it.
  hostCommunityId String?
  hostCommunity   Community?          @relation("TournamentHostCommunity", fields: [hostCommunityId], references: [id], onDelete: SetNull)
  /// Where the money for a sponsored prize is coming from — see TournamentSponsorship.
  sponsorship     TournamentSponsorship?

  @@index([game, status])
  @@index([country])
  // V1 audit follow-up — dashboard/payouts, dashboard's own overview, and
  // the community route all filter by organizerId alone (no game/status
  // alongside it), so the composite index above doesn't help those reads.
  @@index([organizerId])
  // /api/search's `contains`/insensitive predicates (finding #11 of the
  // security audit). These compile to ILIKE '%q%', which no btree — this
  // model's own (game, status) included — can serve; they were sequential
  // scans. Needs pg_trgm, created by the migration alongside them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([game(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Where the money for a sponsored prize is coming from. One at most per tournament.
///
/// Finding #3 of the security audit, follow-up two of two. A staff-run tournament is sponsored: its prize
/// is paid from Circuit's own balance, so the rule that a prize can't exceed the entry fees collected does
/// not apply to it. Two things now bound that. The prize has a ceiling (maxSponsoredPrizeKobo), and it has
/// to be approved by a staff member who is neither the organizer nor a winner (payoutApproval.ts). What was
/// still missing is any record of where the money comes from: the approval row named who said yes, and
/// nothing named what they were saying yes to.
///
/// This is that record, and it is required — a sponsored prize with no sponsorship recorded (or one
/// recorded for less than the unbacked amount) cannot be approved at all, by anyone, including a super
/// admin. Without it the separation-of-duties rule only guarantees the second person agreed; with it they
/// are agreeing to a stated amount from a stated source, in writing, on the record.
///
/// Deliberately not a ledger. Nothing here moves money or reserves it — it is a declaration, checked
/// against the payout's unbacked amount at approval time. `source` is free text because the honest answer
/// is a budget line or a sponsor's name, neither of which is a fixed vocabulary.
model TournamentSponsorship {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// The staff member who recorded it. Named for the record, not for the money: the source of the funds is
  /// `source`, and on a platform-funded tournament the funder is Circuit itself.
  recordedById String
  recordedBy   User       @relation("SponsorshipsRecorded", fields: [recordedById], references: [id], onDelete: Cascade)
  /// What is being put behind this prize, in kobo. Has to cover the payout's unbacked amount at approval
  /// time — the shortfall is what the approver is asked to look at.
  amountKobo   Int
  /// Where it is coming from: a budget line, a sponsor, a partner. Free text, length-bounded at the route.
  source       String
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([recordedById])
}

/// Links a User to a Tournament. Maps to REG-1..REG-7.
model Registration {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  status       RegistrationStatus @default(PENDING_PAYMENT)
  /// REG-1's minimum organizer-required field. Display name comes from the
  /// linked User (see ORG-5's CSV export) — in-game ID doesn't live there
  /// since it's per-tournament, not identity.
  inGameId     String
  /// Our own reference (not the provider's), generated at P2-2's charge
  /// init and echoed back by both PaymentProviderClient implementations —
  /// what a webhook looks up a Registration by.
  paymentRef   String?            @unique
  /// TEAM tournaments: the team this entry is for. The registration's
  /// user is its captain — they pay, play the bracket slot, report
  /// results and receive any prize. `teamName` keeps the name as it was
  /// at registration (and survives the team being disbanded).
  teamId       String?
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamName     String?
  createdAt    DateTime           @default(now())
  /// V1 audit follow-up — status moves through the whole
  /// PENDING_PAYMENT→CONFIRMED→WITHDRAWN/REFUNDED lifecycle with no
  /// record of when each transition happened.
  updatedAt    DateTime           @updatedAt

  escrowTxns         EscrowTransaction[]
  roster             RosterMember[]
  lobbyResults       LobbyResult[]
  /// Grouped lobby tournaments: the entry's group (1 = A), and whether it
  /// qualified for the final.
  lobbyGroup         Int?
  lobbyFinalist      Boolean             @default(false)
  /// The player's own stream (optional), when the tournament takes player streams.
  streamPlatform     StreamPlatform?
  streamPlatformName String?
  streamUrl          String?

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  // V1 audit follow-up — the @@unique above leads with tournamentId, so
  // it doesn't serve "every registration for this user" queries (the
  // homepage, a player's public profile, admin's user detail page, and
  // the discovery feed's personalization all run exactly that).
  @@index([userId])
}

/// One player on a team entry's roster (the captain included).
model RosterMember {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("RosterMemberships", fields: [userId], references: [id], onDelete: Cascade)
  inGameId       String?
  /// This player's share of the team's prize, in basis points (10,000 = 100%).
  /// Set by the captain when entering; null on entries made before prizes were
  /// shared, which pay the captain (src/lib/prizePlaces.ts).
  prizeBp        Int?
  createdAt      DateTime     @default(now())

  @@unique([registrationId, userId])
  @@index([userId])
}

/// LOBBY tournaments: one game everyone plays. The organizer enters each
/// entry's placement and kills; points follow the tournament's table.
model LobbyRound {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Unique across the tournament (used in URLs); stage/group/stageRound
  /// say which lobby it is and which of that lobby's rounds.
  number       Int
  stage        LobbyStage       @default(MAIN)
  /// GROUP rounds: 1 = Group A. 0 otherwise.
  group        Int              @default(0)
  /// The round's number within its stage and group (1, 2, …).
  stageRound   Int              @default(0)
  status       LobbyRoundStatus @default(PENDING)
  /// Optional screenshot of the end-of-game results (an /api/images path).
  proofUrl     String?
  postedAt     DateTime?
  /// The in-game custom room for this round. Only confirmed entrants
  /// (and roster players), the organizer and staff can see these.
  roomCode     String?
  roomPassword String?
  roomPostedAt DateTime?
  postedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  results LobbyResult[]
  flags   LobbyFlag[]

  @@unique([tournamentId, number])
}

/// One entry's result in one lobby round. placement null = didn't play.
model LobbyResult {
  id             String       @id @default(cuid())
  roundId        String
  round          LobbyRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  placement      Int?
  kills          Int          @default(0)
  points         Int          @default(0)

  @@unique([roundId, registrationId])
  @@index([registrationId])
}

model LobbyFlag {
  id            String          @id @default(cuid())
  roundId       String
  round         LobbyRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation("LobbyFlagsRaised", fields: [userId], references: [id], onDelete: Cascade)
  reason        String
  status        LobbyFlagStatus @default(OPEN)
  /// The latest answer (organizer's, or staff's once escalated).
  response      String?
  respondedById String?
  escalatedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([roundId, status])
}

/// One row per unordered pair of accounts whose *settled, staked* Battles
/// against each other look like they are moving money one way — the control
/// docs/circuit-strategy.md §10 names as the thing that makes peer-to-peer
/// stakes safe to run ("pattern detection on repeated losses between the same
/// two accounts"). See src/lib/stakePatterns.ts for the two rules and
/// src/lib/matches.ts's sweep for where this gets written.
///
/// This is a queue, not a verdict. Two friends who play each other constantly
/// will show up here eventually, and a 5-0 run between evenly matched players
/// happens roughly 6% of the time by chance alone, in either direction — so
/// nothing here suspends anyone, moves any money, or is shown to a player. It
/// puts a pair in front
/// of a person with the numbers that caused it, and a person decides.
///
/// `userAId` is always the lexicographically smaller of the two ids, so a pair
/// has exactly one spelling and one row. That plus the partial unique index on
/// open flags (hand-written in the migration — Prisma's schema language can't
/// express a WHERE clause on an index) is what keeps the sweep from opening a
/// second flag for a pair every two minutes; the sweep refreshes the evidence
/// below on the flag it already has instead, and only alerts once.
model StakePatternFlag {
  id          String             @id @default(cuid())
  userAId     String
  userA       User               @relation("StakePatternFlagsOnA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId     String
  userB       User               @relation("StakePatternFlagsOnB", fields: [userBId], references: [id], onDelete: Cascade)
  status      StakePatternStatus @default(OPEN)
  /// Which rules fired, as `StakePatternReason` values from
  /// src/lib/stakePatterns.ts. Kept as a list rather than a single value
  /// because both rules fire on the same pair often, and "one-sided AND
  /// high-value" is a different thing to look at than either alone. The
  /// staff queue prints these, so the reason a pair is here is never a
  /// number someone has to re-derive.
  reasons     String[]
  /// The evidence as it stood on the most recent sweep that looked at this
  /// pair — not frozen at creation, because a pair still playing while the
  /// flag waits in the queue is exactly when the numbers matter most. A
  /// snapshot rather than a live re-query so the queue can render without
  /// re-walking every Battle, and so what staff acted on stays readable
  /// after the window has moved past it.
  battleCount Int
  /// Settled staked Battles in the window that `userA`/`userB` won.
  userAWins   Int
  userBWins   Int
  /// Kobo that crossed from one account to the other over those Battles,
  /// signed from `userA`'s side: positive means A is up on B. The per-Battle
  /// amount is the stake (the pot is both stakes, so the winner's own comes
  /// back — see settleBattleOnComplete), so this is the net the loser is
  /// actually down, not the gross the winner's wallet saw.
  netKobo     Int
  /// The lookback this was measured over, so a row still reads correctly
  /// after someone changes the settings that produced it.
  windowDays  Int
  firstBattleAt DateTime?
  lastBattleAt  DateTime?
  /// Who looked at it and what they concluded. Null until then.
  reviewedById String?
  reviewedBy   User?              @relation("StakePatternFlagsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userAId, status])
  @@index([userBId, status])
}

/// 1:1 with Tournament. Maps to BRK-1.
model Bracket {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  generatedAt  DateTime   @default(now())
  /// Rounds & seeding — kept as JSON at this stage; promote specific fields
  /// to columns only if a query needs to filter on them directly.
  structure    Json
}

/// Belongs to a Tournament+Bracket OR a Battle — never both.
/// Enforced at the application layer (see src/lib/matches — not yet built,
/// this is scaffolding only); Postgres CHECK constraint is worth adding in
/// a migration once the app-layer invariant is proven out.
/// Maps to BRK-2..BRK-10 and BTL-4.
model Match {
  id           String      @id @default(cuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  /// One Match per Battle. A Battle is a single head-to-head, so a second Match pointing at the same
  /// battleId can only ever mean the Battle was matched twice — which would settle the pot twice
  /// (`settleBattleOnComplete` pays `stakeAmount * 2` per Match, and the second payout is unbacked
  /// because the second accepter's stake was refunded when the first accept failed). Tournament
  /// matches leave this null, and Postgres permits many nulls in a unique index, so this constrains
  /// Battles only.
  battleId     String?     @unique
  battle       Battle?     @relation(fields: [battleId], references: [id])
  round        Int?

  /// BRK-9: per-match code shown to both players before they play; must
  /// appear in submitted proof to bind that proof to this specific match.
  matchCode String @unique

  playerAId String
  playerA   User   @relation("MatchPlayerA", fields: [playerAId], references: [id])
  playerBId String
  playerB   User   @relation("MatchPlayerB", fields: [playerBId], references: [id])

  status    MatchStatus @default(UPCOMING)
  resultA   Json?
  resultB   Json?
  proofARef String?
  proofBRef String?

  winnerId String?
  winner   User?   @relation("MatchWinner", fields: [winnerId], references: [id])

  /// Battle matches only (see the "Enter Match" flow): when each player
  /// confirmed they're heading into the actual game. Null/null right
  /// after acceptance; both non-null means the match is genuinely live.
  /// UI-only signal — never gates result submission at the API level, so
  /// a stuck "enter" click can never block someone from actually
  /// reporting a real result. Meaningless once a result exists.
  playerAReadyAt DateTime?
  playerBReadyAt DateTime?

  /// BRK-10: silent-side auto-accept deadline once one side has reported.
  reportWindowExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  /// V1 audit follow-up — status cycles UPCOMING→NEEDS_RESULT→DISPUTED→
  /// COMPLETE with no record of when, which matters for reconciling a
  /// stuck or disputed match (it directly gates a tournament's payout and
  /// organizer-revenue settlement).
  updatedAt             DateTime  @updatedAt

  dispute Dispute?

  @@index([tournamentId])
  @@index([status])
  // V1 audit follow-up — the homepage's "your upcoming matches", a
  // player's public profile, admin's user detail page, the wallet-history
  // battle lookup, and discovery's personalization all filter on one of
  // these two fields via an OR (a bitmap-or over two single-column
  // indexes serves that better than one composite would).
  @@index([playerAId])
  @@index([playerBId])
}

/// Created by a User. Maps to BTL-1..BTL-6.
model Battle {
  id           String           @id @default(cuid())
  creatorId    String
  creator      User             @relation("BattleCreator", fields: [creatorId], references: [id])
  /// Same "admin-curated `Game.name`, not a foreign key" convention as
  /// Tournament.game — see that field's comment.
  game         String
  /// "SINGLE" | "BEST_OF_3" — kept as string for the same reason as
  /// Tournament.format above.
  format       String
  visibility   BattleVisibility @default(OPEN)
  targetUserId String?
  targetUser   User?            @relation("BattleTarget", fields: [targetUserId], references: [id])
  /// Kobo. 0 = free (still the vast majority of Battles). Above zero,
  /// this is locked from the creator's wallet at creation and matched
  /// from the accepter's at accept — see `EscrowType.STAKE`. Core escrow
  /// mechanics only (see `EscrowTransaction`'s own comment on what's
  /// deliberately not built yet).
  stakeAmount  Int              @default(0)
  /// Same lightweight link-only field as Tournament.streamUrl — see that
  /// field's comment.
  streamUrl    String?
  status       BattleStatus     @default(OPEN)
  createdAt    DateTime         @default(now())
  /// When an unaccepted challenge lapses (the creator picks 24h / 3 days /
  /// 7 days). Null on challenges made before this existed: those are
  /// treated as lapsing 7 days after `createdAt` (src/lib/battles.ts).
  expiresAt    DateTime?
  /// V1 audit follow-up — status moves OPEN→ACCEPTED→COMPLETE/CANCELLED,
  /// and a staked Battle's stake sits locked the whole time; useful for
  /// spotting how long a Battle has actually been in its current state.
  updatedAt    DateTime         @updatedAt

  matches             Match[]
  escrowTxns          EscrowTransaction[]
  quickMatchChallenge QuickMatchChallenge?

  @@index([game, status])
  // V1 audit follow-up — the homepage's open-challenge feed, a player's
  // public profile, admin's user detail page, the dashboard's own
  // Battles list, and discovery's personalization all filter by one of
  // these two fields directly (often via an OR), same reasoning as
  // Match.playerAId/playerBId above.
  @@index([creatorId])
  @@index([targetUserId])
  // /api/search's `contains` on game (finding #11) — see the note on
  // Tournament's trigram indexes. The (game, status) btree above cannot
  // serve a leading-wildcard ILIKE.
  @@index([game(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum QuickMatchStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum QuickMatchRecipientStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// A single host challenge fanned out to many eligible recipients at once
/// (`QuickMatchRecipient`, one row per invitee) — the first to accept wins
/// it, and every other still-`PENDING` recipient row flips to `CANCELLED`
/// in the same transaction. Resolves into a completely ordinary `Battle` +
/// `Match` the moment someone accepts (`battleId` below), created directly
/// in `ACCEPTED` status rather than going through the OPEN board — nothing
/// downstream of that point (result submission, disputes, settlement)
/// knows or cares that a Battle originated from Quick Match. Same stake
/// mechanics and the same not-launch-ready caveat as `Battle.stakeAmount`
/// (see `EscrowTransaction`'s own comment) — Quick Match widens the same
/// unresolved collusion-surface risk that comment already flags, since one
/// host stake can now reach many more potential accepters at once.
model QuickMatchChallenge {
  id               String           @id @default(cuid())
  hostId           String
  host             User             @relation("QuickMatchHost", fields: [hostId], references: [id])
  /// Same "admin-curated Game.name, not a foreign key" convention as
  /// Battle.game/Tournament.game.
  game             String
  /// "SINGLE" | "BEST_OF_3" — same free-text convention as Battle.format.
  format           String
  /// Kobo. 0 = free. Above zero, locked from the host's wallet the moment
  /// this challenge is created (not deferred to acceptance) — see
  /// `EscrowType.STAKE`.
  stakeAmount      Int              @default(0)
  status           QuickMatchStatus @default(PENDING)
  acceptedByUserId String?
  acceptedBy       User?            @relation("QuickMatchAcceptedBy", fields: [acceptedByUserId], references: [id])
  battleId         String?          @unique
  battle           Battle?          @relation(fields: [battleId], references: [id])
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  acceptedAt       DateTime?
  cancelledAt      DateTime?

  recipients QuickMatchRecipient[]
  escrowTxns EscrowTransaction[]

  @@index([hostId])
  @@index([status])
  @@index([expiresAt])
}

/// One row per player a `QuickMatchChallenge` was fanned out to. The
/// winning row (whoever's accept request wins the challenge's own
/// PENDING→ACCEPTED compare-and-swap) flips to ACCEPTED; every other row
/// still PENDING at that moment flips to CANCELLED in the same
/// transaction — see the challenge's accept route for the exact sequence.
model QuickMatchRecipient {
  id              String                    @id @default(cuid())
  challengeId     String
  challenge       QuickMatchChallenge       @relation(fields: [challengeId], references: [id])
  recipientUserId String
  recipient       User                      @relation("QuickMatchRecipient", fields: [recipientUserId], references: [id])
  status          QuickMatchRecipientStatus @default(PENDING)
  sentAt          DateTime                  @default(now())
  respondedAt     DateTime?

  @@unique([challengeId, recipientUserId])
  @@index([recipientUserId, status])
  @@index([challengeId, status])
}

/// Belongs to a Match. Maps to BRK-5, BRK-6, TRU-1..TRU-2.
model Dispute {
  id                      String        @id @default(cuid())
  matchId                 String        @unique
  match                   Match         @relation(fields: [matchId], references: [id])
  raisedById              String
  raisedBy                User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  status                  DisputeStatus @default(OPEN)
  /// BRK-5's 24h (placeholder) window: the organizer must rule by this
  /// time or the sweep (P3-6/BRK-6) escalates to the Phase 6 staff queue.
  /// Null for a Battle dispute or one escalated immediately (organizer is
  /// a disputant) — there's no organizer-review phase to time out.
  organizerRulingDeadline DateTime?
  ruling                  String?
  ruledById               String?
  ruledAt                 DateTime?
  createdAt               DateTime      @default(now())
  /// V1 audit follow-up — status moves OPEN→ORGANIZER_REVIEW/ESCALATED→
  /// RESOLVED/VOID, including a sweep step that flips OPEN→ESCALATED, with
  /// no timestamp anywhere except `ruledAt` (only set at final
  /// resolution). Staff couldn't tell how long a dispute had actually sat
  /// in ESCALATED, which matters for an SLA-driven queue.
  updatedAt               DateTime      @updatedAt

  @@index([status])
}

/// Belongs to a Tournament (with an optional Registration) OR a Battle
/// (with a User) — exactly one of tournamentId/battleId is set, same
/// app-layer-enforced "exactly one owner" convention as Match's own
/// tournamentId/battleId pair (no DB CHECK constraint). Maps to REG-2,
/// REG-5, REG-6, ORG-4 (tournament side) and BTL-1..BTL-6 (Battle stake
/// side — core escrow mechanics only: no per-account stake limits,
/// collusion detection, or self-exclusion tooling yet, so this does not
/// meet the bar docs/circuit-strategy.md sets for a launched, legally-
/// reviewed staked-Battles feature. Shipped as the underlying mechanism
/// only, per explicit product decision.)
model EscrowTransaction {
  id                    String               @id @default(cuid())
  tournamentId          String?
  tournament            Tournament?          @relation(fields: [tournamentId], references: [id])
  registrationId        String?
  registration          Registration?        @relation(fields: [registrationId], references: [id])
  /// Set for a Battle-stake row (STAKE/STAKE_PAYOUT/REFUND — who paid or
  /// received it) and for an ORGANIZER_REVENUE row (the organizer the
  /// settlement sweep credits — see that EscrowType's own comment). Null
  /// for every other tournament-side row, where `registration.userId`
  /// already answers this.
  battleId              String?
  battle                Battle?              @relation(fields: [battleId], references: [id])
  /// Set for a Quick Match host's stake lock/refund, from the moment the
  /// challenge is created until it either resolves into a real Battle
  /// (at which point `battleId` above is ALSO backfilled onto this same
  /// row, not a new one) or expires/cancels unaccepted. Lets the wallet
  /// history page (`src/lib/wallet.ts`) show this row even during the
  /// window before any Battle exists.
  quickMatchChallengeId String?
  quickMatchChallenge   QuickMatchChallenge? @relation(fields: [quickMatchChallengeId], references: [id])
  userId                String?
  /// V1 audit follow-up — matches WalletTransaction.userId's onDelete
  /// (RESTRICT): a User with financial history (a Battle payout, or
  /// organizer revenue) shouldn't be deletable in a way that silently
  /// orphans that history, even though nothing deletes a User today.
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  type                  EscrowType
  /// PRIZE_PAYOUT: the finishing place this share is for (1 = champion).
  /// Null on payouts from before split prizes (always the champion's).
  place                 Int?
  /// Minor currency units (kobo).
  amount                Int
  /// Null for a Battle-stake row — wallet-balance-only, no external
  /// provider touched (same reasoning as `WalletTransactionType.
  /// STAKE_DEBIT`/`STAKE_PAYOUT_CREDIT`).
  provider              PaymentProviderName?
  /// Unique like WalletTransaction.providerRef — a duplicate provider
  /// reference (a literal webhook replay, or two writes racing to record
  /// the same transfer/charge) fails at the DB, not just in application
  /// logic. Multiple NULLs are fine (Postgres doesn't treat them as
  /// duplicates) — only set once a provider call actually returns one.
  providerRef           String?              @unique
  status                EscrowStatus         @default(PENDING)
  createdAt             DateTime             @default(now())
  /// V1 audit follow-up — status flips PENDING→COMPLETE/FAILED (a payout
  /// claim, a settlement) after creation with no record of when.
  updatedAt             DateTime             @updatedAt

  @@index([tournamentId, type])
  @@index([battleId, type])
  @@index([quickMatchChallengeId, type])
  // V1 audit follow-up — the wallet page's own Battle-activity section
  // filters by userId directly (`where: { userId, battleId: { not: null } }`),
  // which neither composite index above serves.
  @@index([userId])
  @@index([registrationId])
}

/// Belongs to a User. Maps to NOT-1..NOT-4.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Belongs to a User. New for the community-feed rebuild (not in the
/// original PRD's requirement numbering) — a public, unmoderated-beyond-
/// Report post feed. No likes/comments yet (deferred as a smaller,
/// separately-scoped follow-up). The feed's Friends/Teams tabs filter
/// this same table by `Friendship`/`TeamMembership` — see those models.
model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("CommunityPostAuthor", fields: [authorId], references: [id])
  /// Plain text, length-capped (see parseCommunityPostContent) — no rich
  /// text, no image attachment (an attachment would need either the
  /// private HMAC-signed proof storage repurposed for public reads, or a
  /// second storage path — real scope this request didn't ask for).
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Belongs to two Users (directed: requester → addressee). One row covers
/// the whole lifecycle — a pending request becomes `accepted: true` on
/// acceptance; declining a request, cancelling one you sent, or
/// unfriending an accepted one all just delete the row, so there's no
/// separate DECLINED state to reason about or clean up later. Powers the
/// Friends tabs on the community feed, ladder, and homepage leaderboard —
/// see `src/lib/friends.ts`.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, accepted])
  @@index([requesterId, accepted])
}

/// A persistent squad — name, optional tag, a roster, one captain.
/// Deliberately NOT wired into tournament/challenge registration:
/// `Registration` stays one row per individual `User` (see that model's
/// own comment) — a `Team` here is a social grouping only, not a new
/// registration unit. The captain leaves by disbanding the team (there's
/// no captaincy-transfer flow); anyone else just leaves their own
/// `TeamMembership` row.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String?
  /// Free text, same convention as Tournament.game/Battle.game/
  /// User.favoriteGames — not a Game-catalog foreign key. Added for
  /// Player & Team Discovery Phase 3: without this, "browse teams by
  /// game" has nothing real to filter on. Optional — a team can exist
  /// before its captain sets one.
  game      String?
  /// Free text city/state/country, same convention as User.region.
  region    String?
  captainId String
  captain   User     @relation("TeamCaptain", fields: [captainId], references: [id])
  createdAt DateTime @default(now())

  members       TeamMembership[]
  communities   CommunityTeam[]
  registrations Registration[]

  // V1 audit follow-up — a player's public profile and the team-role
  // lookup in src/lib/teams.ts both filter by captainId directly, with no
  // supporting index (only `name` had one, via its own unique constraint).
  @@index([captainId])
}

/// One row per (team, user) pair, including the captain's own membership
/// (created alongside the `Team`). `accepted: false` is a pending invite
/// the invited user hasn't responded to yet — same "no separate DECLINED
/// state" convention as `Friendship`: declining an invite, leaving, and
/// being removed all just delete the row.
model TeamMembership {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  accepted          Boolean  @default(false)
  /// Distinguishes who started this pending row, since `accepted: false`
  /// now means either direction (Discovery Phase 3): false (default) is
  /// the original captain-invites-a-handle flow (the invited user
  /// accepts); true is a player requesting to join a team found via
  /// Discovery (the captain accepts). Same row shape, different
  /// permission check on whoever's allowed to flip `accepted`.
  requestedByMember Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId, accepted])
}

/// Belongs to a reported User. Maps to TRU-3.
model Report {
  id             String       @id @default(cuid())
  reportedUserId String
  reportedUser   User         @relation("ReportAgainstUser", fields: [reportedUserId], references: [id])
  reportedById   String
  reportedBy     User         @relation("ReportFiledBy", fields: [reportedById], references: [id])
  reason         String
  /// Optional evidence upload (TRU-3) — reuses proofStorage (src/lib/
  /// storage.ts), keyed by this report's own id rather than a matchId;
  /// that storage interface only ever cared about an opaque string key.
  evidenceRef    String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([reportedUserId, status])
}

// ---------------------------------------------------------------------------
// Admin dashboard (Content / Calendar / Settings) — Phase 5.
// ---------------------------------------------------------------------------

/// One slide in the homepage hero carousel — admin-authored, real content
/// `CircuitHero` renders alongside its own real tournament-spotlight
/// slides (see that component's own comment). `imageUrl` is an uploaded
/// image's `/api/images/<ref>` path (src/lib/uploads.ts) or a linked
/// external URL — same shape as User.avatarUrl/Tournament.posterUrl.
model HomepageBanner {
  id          String    @id @default(cuid())
  headline    String
  description String?
  imageUrl    String
  ctaLabel    String?
  ctaHref     String?
  /// Lower sorts first. Admin-set via reordering, not auto-computed.
  order       Int       @default(0)
  enabled     Boolean   @default(true)
  /// Null = publish immediately once enabled. In the future = scheduled,
  /// not yet shown on the real homepage.
  publishAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([enabled, order])
}

/// A site-wide notice — real content the homepage renders in a small
/// dismissible strip when at least one row is enabled (most recent wins;
/// see `getActiveAnnouncement`). No targeting/scheduling — same "keep it
/// minimal" instruction the whole admin build follows.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([enabled, createdAt])
}

/// The two categories the player calendar's own "Community"/"Game
/// Releases" tabs were left disabled for (see src/app/calendar/page.tsx's
/// header comment) — Tournaments and Challenges are still derived
/// entirely from real `Tournament`/`Battle` rows, never admin-authored
/// here, since inventing a "competition" that isn't a real tournament
/// would break that page's whole real-data discipline.
enum CalendarEventCategory {
  COMMUNITY
  GAME_RELEASE
}

model CalendarEvent {
  id        String                @id @default(cuid())
  title     String
  category  CalendarEventCategory
  date      DateTime
  cancelled Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([category, date])
}

/// Singleton row (`id` is always "singleton") — real platform-wide
/// toggles and defaults, each added only once there was a genuine
/// feature behind it (maintenance mode; the platform fee rate; the
/// cancellation-lock default below), not a grab-bag of unused fields
/// invented to look complete; see `/admin/settings`'s own comment.
model PlatformSetting {
  id                               String  @id @default("singleton")
  maintenanceMode                  Boolean @default(false)
  /// Circuit's cut of every paid tournament entry, in basis points (1/100
  /// of a percent — 500 = 5.00%) rather than a plain integer percent, so
  /// a future rate change never needs a fractional-percent migration.
  /// Admin-configurable (Admin > Settings), not a code constant, on
  /// purpose: the exact rate is a business decision that can change
  /// without a deploy — see PlatformFeeControl.tsx. Applied only to new
  /// entry-fee confirmations going forward; changing it never rewrites
  /// already-recorded PLATFORM_FEE escrow rows.
  platformFeeBps                   Int     @default(500)
  /// Default lead time for Tournament.cancellationLockAt, computed once
  /// at tournament creation (startAt minus this many hours) and stored
  /// as a concrete timestamp on that row — not re-derived from this
  /// setting later, so changing the default never moves the lock point
  /// on a tournament that already has one. See cancellationLockAt's own
  /// schema comment for why this exists as its own timestamp instead of
  /// reusing startAt or registrationCloseAt.
  cancellationLockHoursBeforeStart Int     @default(24)
  /// Dispute/review buffer after a tournament's final match completes
  /// (Tournament.completedAt) before its PENDING ORGANIZER_REVENUE escrow
  /// rows settle into the organizer's wallet balance — see
  /// settleOrganizerRevenue() in src/lib/settlement.ts. Same "computed
  /// once, not re-derived later" caution doesn't apply here: unlike
  /// cancellationLockAt, this is read fresh at sweep time (no per-
  /// tournament snapshot column), so changing it via Admin > Settings
  /// (OrganizerRevenueSettlementControl.tsx) does shift the settle point
  /// for every still-PENDING row, not just new ones.
  organizerRevenueSettlementHours  Int     @default(24)
  /// Approve a completed tournament's payout automatically once the settlement wait has passed, when it has
  /// no disputes or flags, no freeze, and the money to pay out is within payoutAutoApproveMaxKobo. Anything
  /// else waits for a person on the admin Payouts page. Turn off to make every payout manual.
  payoutAutoApprove                Boolean @default(true)
  /// The most (winners' prizes plus the organizer's share) that is approved automatically, in kobo. Bigger
  /// payouts always wait for staff. Default NGN 500,000.
  payoutAutoApproveMaxKobo         Int     @default(50000000)
  /// The largest cash prize a staff-run (sponsored) tournament may declare, in kobo. Default NGN 5,000,000.
  ///
  /// An ordinary tournament's prize is capped at the entry fees it could collect, because that is where the
  /// money comes from (prizePool.ts). A sponsored one is paid from Circuit's own balance, and that exemption
  /// used to have no ceiling at all — a staff organizer could declare any prize, collect nothing, and have
  /// it paid to a confederate. This is the ceiling the exemption was missing. It does not need to be tight to
  /// do its job: its work is bounding a mistyped or bad-faith declaration, and the separation-of-duties rule
  /// in payoutApproval.ts is what puts a second person in front of the money. Zero is allowed and means staff
  /// may not declare a cash prize at all, which is the kill switch rather than a nonsense value.
  maxSponsoredPrizeKobo            Int     @default(500000000)
  /// Staked Battles' kill switch. The feature deliberately shipped with the
  /// escrow mechanism only and none of the responsible-gambling controls
  /// docs/circuit-strategy.md §10 requires, so this exists to stop it
  /// instantly if the collusion/laundering risk behind that section needs
  /// to halt while a fix lands. Gates LOCKING a new stake only (see
  /// lockStake in src/lib/stakes.ts): an open Battle or a pending Quick
  /// Match challenge still expires and refunds normally, so switching this
  /// off drains the feature rather than stranding money in it.
  stakedBattlesEnabled             Boolean @default(true)
  /// The most a single account may have locked across every open Battle and
  /// every pending Quick Match challenge at once, in kobo. Default NGN
  /// 500,000 — 5x the per-Battle cap (MAX_STAKE_AMOUNT), so it only bites
  /// an account running several stakes at once. This is the control the
  /// per-Battle cap structurally cannot provide: twenty concurrent NGN
  /// 100,000 Battles are within every per-Battle rule and are still a NGN
  /// 2,000,000 exposure between two colluding accounts.
  maxLockedStakeKobo               Int     @default(50000000)
  /// The most a single account may stake in any rolling 24 hours, in kobo,
  /// whether or not those stakes have since settled or been refunded.
  /// Default NGN 1,000,000. Counted by creation time and not by outcome on
  /// purpose: if a refund handed back the throughput budget, a pair could
  /// move any amount by opening and cancelling in a loop.
  maxDailyStakeKobo                Int     @default(100000000)
  /// How far back the repeated-pair collusion sweep looks when it counts a
  /// pair's settled staked Battles (src/lib/stakePatterns.ts). Default 90
  /// days. A rolling window rather than a lifetime total on purpose: two
  /// accounts that played each other honestly two years ago and have since
  /// started throwing games should still surface, and a lifetime count would
  /// wash that signal out in old noise. Read fresh at sweep time like the
  /// settlement window above, so changing it re-measures every pair on the
  /// next run.
  stakePatternWindowDays           Int     @default(90)
  /// The fewest settled staked Battles a pair needs before the win-record
  /// rule will look at them. Default 5. This is the sample floor, and it is
  /// the knob that decides how much noise the queue carries: at a 5-Battle
  /// floor and an 80% share, an honest pair sweeps 5-0 (or 0-5) about 6% of
  /// the time, so a busy platform will hand staff some innocent pairs. Raise
  /// it to trade earlier detection for a quieter queue.
  stakePatternMinBattles           Int     @default(5)
  /// How lopsided a pair's win record has to be before that rule fires, in
  /// basis points (8000 = 80.00%) — same bps convention as platformFeeBps.
  /// Ignored below `stakePatternMinBattles`. One side winning 80% of five
  /// games is unremarkable; one side winning 80% of forty is not, which is
  /// why this and the floor are read together rather than either alone.
  stakePatternWinShareBps          Int     @default(8000)
  /// The net kobo a pair has to have moved between them, over the window,
  /// for the high-value rule to fire on its own — whatever their win record.
  /// Default NGN 500,000. This is the rule for a pair quietly recycling
  /// large amounts at a near-even record: a slow drain needs many Battles to
  /// move real money, so it never produces a lopsided record for the other
  /// rule to catch, and the size itself is the reason to look.
  stakePatternNetAlertKobo         Int     @default(50000000)
}

/// Every real write an admin makes anywhere in `/admin` appends one row
/// here — Settings > Audit Log reads this back, nothing else. `metadata`
/// is intentionally loose (Json) since each action logs different
/// details (a suspension reason, a role change's before/after, etc.).
model AuditLogEntry {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// V1 rate limiting (ACC-5) — a small attempts table queried per request,
/// not Redis; see docs/circuit-stack.md's Rate limiting section for why
/// ("does the same job at V1's actual traffic without standing up a new
/// service" — Upstash Redis is the named upgrade path if that ever stops
/// being true). `key` scopes an attempt to both the action and the
/// identifier it's against (e.g. "login:user@example.com"), so this one
/// table covers every rate-limited route without a migration per route.
/// Self-cleaning, not swept by a cron job — see src/lib/rateLimit.ts.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  // For the sweep's age-based purge (finding #14). The composite above leads with `key`, so it cannot
  // serve `createdAt < cutoff` across every key at once — without this the two-minute sweep would be a
  // sequential scan of the table it exists to keep small.
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Video Feed (Circuit Video Feed spec, Phase 1 — foundation)
// ---------------------------------------------------------------------------

enum VideoSource {
  CIRCUIT
  YOUTUBE
}

enum VideoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Unified model so Circuit-managed clips and (Phase 3) official YouTube
/// gaming Shorts can appear in the same feed. `game` follows the same
/// free-text convention as `Tournament.game`/`Battle.game` (not a foreign
/// key to the admin `Game` catalog — see that model's comment), so a video
/// can reference any real game name without depending on catalog upkeep.
/// `tournamentId` is optional and only ever set for Circuit-managed
/// highlight/announcement clips tied to a real tournament.
model Video {
  id           String      @id @default(cuid())
  /// Stable, URL-safe identifier for `/videos/[slug]` deep links — derived
  /// from `title` at creation, not user-editable.
  slug         String      @unique
  source       VideoSource @default(CIRCUIT)
  title        String
  description  String?
  /// Directly playable file — required for `source: CIRCUIT`, null for
  /// `source: YOUTUBE` (Phase 3 plays those via the official embed instead).
  videoUrl     String?
  thumbnailUrl String?
  /// External canonical URL — required for `source: YOUTUBE` attribution,
  /// unused for Circuit-managed content.
  sourceUrl    String?
  sourceAuthor String?
  /// Free text, same convention as `Tournament.game` — see that field's
  /// comment above.
  game         String?
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  tags         String[]    @default([])
  likes        Int         @default(0)
  views        Int         @default(0)
  shares       Int         @default(0)
  status       VideoStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())

  likedBy VideoLike[]
  savedBy VideoSave[]

  @@index([status, publishedAt])
  @@index([game])
}

/// One row per (user, video) like — the duplicate-like guard the product
/// spec calls for. `Video.likes` is the fast denormalized counter, kept in
/// sync in the same transaction as this row's insert/delete.
model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

/// Same shape as `VideoLike`, for the "Save" interaction.
model VideoSave {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

// ---------------------------------------------------------------------------
// Circuit Communities — Discord-style communities with channels, roles,
// moderation and invite links. Four kinds (CommunityKind): the platform-
// wide Circuit community, one per tournament, an official hub per catalog
// game, and player-made communities. Unrelated to `CommunityPost` above
// despite the name (that is the retired flat feed).
//
// No real-time transport — messages are read via polling (see
// `Poller.tsx`: no WebSocket infra, and Vercel serverless can't hold one
// open; Pusher/Ably are the escalation path). Code: src/lib/community*.ts.
// ---------------------------------------------------------------------------

/// A community. TOURNAMENT ones are 1:1 with their tournament and
/// `enabled` is the organizer's switch (disabling keeps history).
/// PLAYER ones are "closed" by setting enabled = false, keeping the slug
/// taken. The GLOBAL singleton is kept to one row by
/// getOrCreateGlobalCommunity plus its unique slug.
model Community {
  id                  String              @id @default(cuid())
  kind                CommunityKind       @default(TOURNAMENT)
  tournamentId        String?             @unique
  tournament          Tournament?         @relation(fields: [tournamentId], references: [id])
  /// Mirrors kind == GLOBAL (older code paths read it).
  isGlobal            Boolean             @default(false)
  enabled             Boolean             @default(true)
  /// URL name: /communities/<slug>. Null for TOURNAMENT communities,
  /// which live under their tournament instead.
  slug                String?             @unique
  /// Null for TOURNAMENT communities (they show the tournament's name).
  name                String?
  description         String?
  iconUrl             String?
  bannerUrl           String?
  /// 2-5 character tag members can wear next to their name.
  tag                 String?
  /// GAME_HUB: the game it's for. PLAYER: optional main game (discovery filter).
  gameId              String?
  game                Game?               @relation(fields: [gameId], references: [id])
  /// Free-text city/state, same convention as User.region.
  region              String?
  joinPolicy          CommunityJoinPolicy @default(OPEN)
  /// What it's about (discovery filter). Null for GLOBAL/TOURNAMENT.
  category            CommunityCategory?
  /// Set when Circuit staff suspend it (enabled is false too). The owner
  /// can appeal; a closed-by-owner community has enabled false but no suspendedAt.
  suspendedAt         DateTime?
  suspensionReason    String?
  /// Shown before joining; joining means accepting them.
  rules               String?
  /// APPLY only: the one question applicants answer.
  applicationQuestion String?
  ownerId             String?
  owner               User?               @relation("CommunityOwner", fields: [ownerId], references: [id])
  /// Bumped on every message: discovery ranks by recent activity.
  lastActivityAt      DateTime?
  createdAt           DateTime            @default(now())

  channels          Channel[]
  members           CommunityMember[]
  invites           CommunityInvite[]
  applications      CommunityApplication[]
  bans              CommunityBan[]
  hostedTournaments Tournament[]           @relation("TournamentHostCommunity")
  featuredBy        User[]                 @relation("FeaturedCommunity")
  mutes             CommunityMute[]
  reports           CommunityReport[]
  appeals           Appeal[]
  teams             CommunityTeam[]
  events            CommunityEvent[]

  @@index([kind, enabled])
  @@index([gameId])
  // /api/search's `contains` on name (finding #11) — see the note on
  // Tournament's trigram indexes.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// What a community is for. GLOBAL: the single platform-wide "Circuit"
/// community every account is in. TOURNAMENT: 1:1 with a tournament, for
/// its players. GAME_HUB: the official, staff-run community for one
/// catalog game. PLAYER: made by a player (crews, campus groups, city scenes).
enum CommunityKind {
  GLOBAL
  TOURNAMENT
  GAME_HUB
  /// Staff-run location or interest community (Lagos, Competitive Gaming…).
  OFFICIAL
  PLAYER
}

/// How people get in. OPEN: listed in discovery, anyone joins. APPLY:
/// listed, a moderator approves each application. INVITE: unlisted, only
/// an invite link gets you in.
enum CommunityJoinPolicy {
  OPEN
  APPLY
  INVITE
}

enum CommunityCategory {
  GAME
  LOCATION
  INTEREST
  SCHOOL
  CLUB
  ORGANISATION
  CREATOR
}

/// A team that's part of a community. Communities are the social layer,
/// teams the competitive unit: a team can be in many communities and a
/// community holds many teams. The captain adds it (they must be a member);
/// the captain or the community's moderators can remove it.
model CommunityTeam {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  addedById   String
  createdAt   DateTime  @default(now())

  @@unique([communityId, teamId])
  @@index([teamId])
}

/// Something a community is doing at a set time — FIFA night, a meetup, a
/// watch party. (Tournaments a community hosts show alongside these; see
/// Tournament.hostCommunityId.) Moderators create them; members RSVP.
model CommunityEvent {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  /// Where: "Online — #general", a venue, an address.
  location    String?
  createdById String
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  rsvps EventRsvp[]

  @@index([communityId, startsAt])
}

enum RsvpStatus {
  GOING
  INTERESTED
}

model EventRsvp {
  id        String         @id @default(cuid())
  eventId   String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  createdAt DateTime       @default(now())

  @@unique([eventId, userId])
}

/// A timeout: they can still read, but can't post or react until `until`.
model CommunityMute {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("CommunityMuted", fields: [userId], references: [id], onDelete: Cascade)
  mutedById   String
  until       DateTime
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

enum ReportReason {
  HARASSMENT
  HATE
  SPAM
  SCAM
  SEXUAL
  CHEATING
  THREATS
  IMPERSONATION
  OTHER
}

enum CommunityReportTarget {
  MESSAGE
  MEMBER
  COMMUNITY
  THREAD
}

/// OPEN: with the community's moderators. ESCALATED: with Circuit staff
/// (serious reasons and reports about a whole community go straight here).
enum CommunityReportStatus {
  OPEN
  ESCALATED
  ACTIONED
  DISMISSED
}

/// A report about something inside a community. `messageContent` keeps a
/// copy of the reported text so the evidence survives the message being
/// removed.
model CommunityReport {
  id             String                @id @default(cuid())
  communityId    String
  community      Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  targetType     CommunityReportTarget
  messageId      String?
  message        Message?              @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageContent String?
  threadId       String?
  thread         Thread?               @relation(fields: [threadId], references: [id], onDelete: SetNull)
  targetUserId   String?
  targetUser     User?                 @relation("CommunityReportAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)
  reporterId     String
  reporter       User                  @relation("CommunityReportFiledBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reason         ReportReason
  details        String?
  status         CommunityReportStatus @default(OPEN)
  escalatedAt    DateTime?
  handledById    String?
  handledAt      DateTime?
  resolution     String?
  createdAt      DateTime              @default(now())

  @@index([communityId, status])
  @@index([status])
}

enum AppealKind {
  COMMUNITY_SUSPENSION
  ACCOUNT_SUSPENSION
}

enum AppealStatus {
  OPEN
  UPHELD
  OVERTURNED
}

/// Asking Circuit staff to reverse a suspension (of an account, or of a
/// community they own). One open appeal at a time per subject.
model Appeal {
  id          String       @id @default(cuid())
  kind        AppealKind
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String?
  community   Community?   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  message     String
  status      AppealStatus @default(OPEN)
  response    String?
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([status])
  @@index([userId])
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

/// A shareable join link: /invite/<code>. Optional expiry and use limit.
model CommunityInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("CommunityInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([communityId])
}

enum CommunityApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A request to join an APPLY community. One row per person per
/// community; re-applying after a rejection resets it to PENDING.
model CommunityApplication {
  id           String                     @id @default(cuid())
  communityId  String
  community    Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId       String
  user         User                       @relation("CommunityApplicant", fields: [userId], references: [id], onDelete: Cascade)
  answer       String                     @default("")
  status       CommunityApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                   @default(now())

  @@unique([communityId, userId])
  @@index([communityId, status])
}

/// Removed by a moderator and kept out: joining, applying and invite
/// links all refuse until the ban is lifted.
model CommunityBan {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("CommunityBanned", fields: [userId], references: [id], onDelete: Cascade)
  bannedById  String
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

/// The four fixed V1 channels (general/announcements/matches/results),
/// created together when a Community is enabled. `key` (not just `name`)
/// exists because Phase 3's auto-generated match/tournament event
/// messages need to target "the matches channel" and "the results
/// channel" programmatically by a stable identifier, not by matching on
/// a human-editable display name.
model Channel {
  id              String    @id @default(cuid())
  communityId     String
  community       Community @relation(fields: [communityId], references: [id])
  key             String
  name            String
  /// Display order, ascending.
  position        Int       @default(0)
  /// Only owners/moderators may post (e.g. #announcements).
  modOnly         Boolean   @default(false)
  /// Members may post once per this many seconds (0 = off). Moderators are exempt.
  slowModeSeconds Int       @default(0)
  createdAt       DateTime  @default(now())

  messages Message[]
  threads  Thread[]

  @@unique([communityId, key])
}

/// Join/leave membership — posting or reading requires a row here. A
/// single `lastReadAt` per member (not per-channel) is Phase 1's
/// deliberately basic unread signal: "anything new since I last opened
/// this community," not a per-channel read receipt.
model CommunityMember {
  id          String        @id @default(cuid())
  communityId String
  community   Community     @relation(fields: [communityId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  lastReadAt  DateTime      @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

/// What a chat Message carries beyond its text. TEXT is the original
/// Phase 1 plain-text message; IMAGE has an uploaded picture/GIF
/// (`attachmentRef`) with optional caption in `content`; STICKER is one
/// of Circuit's built-in stickers (`stickerId`, see src/lib/stickers.ts)
/// with empty `content`.
enum MessageKind {
  TEXT
  IMAGE
  STICKER
}

/// No edit history. `isSystem` is unused today (nothing sets it true yet)
/// but exists so Phase 3's auto-generated match/tournament event messages
/// don't need a schema change to be visually distinguished from a real
/// user's message.
model Message {
  id                 String      @id @default(cuid())
  channelId          String
  channel            Channel     @relation(fields: [channelId], references: [id])
  authorId           String
  author             User        @relation(fields: [authorId], references: [id])
  kind               MessageKind @default(TEXT)
  /// The text, or an IMAGE's optional caption. Empty for a STICKER.
  content            String      @default("")
  /// IMAGE only — an opaque, signed proofStorage reference (never a
  /// public URL), served through the membership-checked
  /// /api/messages/[id]/attachment route, same access discipline as
  /// match proof and report evidence.
  attachmentRef      String?
  /// IMAGE only — the uploaded file's real pixel size, so the client can
  /// reserve the right box before the image loads (no scroll jump).
  attachmentWidth    Int?
  attachmentHeight   Int?
  /// STICKER only — a key into the fixed sticker set in src/lib/stickers.ts.
  stickerId          String?
  isSystem           Boolean     @default(false)
  createdAt          DateTime    @default(now())
  /// Removed by its author or a moderator. Kept as a row (content wiped)
  /// so polling clients learn about it: removal bumps reactionsChangedAt.
  deletedAt          DateTime?
  /// Bumped on every reaction add/remove. Polling only asks for messages
  /// newer than the last one it has, so this is how a reaction change on
  /// an older message reaches other viewers (`reactionsSince` on the
  /// channel messages GET) — removals leave no row behind to find.
  reactionsChangedAt DateTime?
  /// The message this one replies to (quoted above it). Kept if that one
  /// is removed — it then shows as "original message removed".
  replyToId          String?
  replyTo            Message?    @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  /// Set for messages posted inside a thread; they don't appear in the
  /// channel's main feed.
  threadId           String?
  thread             Thread?     @relation("ThreadMessages", fields: [threadId], references: [id], onDelete: Cascade)
  /// Pinned to its channel by a moderator.
  pinnedAt           DateTime?
  pinnedById         String?

  mentions      MessageMention[]
  reactions     MessageReaction[]
  reports       CommunityReport[]
  replies       Message[]         @relation("MessageReplies")
  startedThread Thread?           @relation("ThreadStarter")

  @@index([channelId, createdAt])
  @@index([channelId, reactionsChangedAt])
  @@index([threadId, createdAt])
  @@index([channelId, pinnedAt])
}

/// A side conversation inside a channel ("Looking for COD teammates"),
/// optionally started from a message. Moderators can lock it (only they
/// can post then).
model Thread {
  id               String   @id @default(cuid())
  channelId        String
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Denormalised so a community's active threads list in one query.
  communityId      String
  title            String
  creatorId        String
  starterMessageId String?  @unique
  starterMessage   Message? @relation("ThreadStarter", fields: [starterMessageId], references: [id], onDelete: SetNull)
  locked           Boolean  @default(false)
  messageCount     Int      @default(0)
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  messages Message[]         @relation("ThreadMessages")
  reports  CommunityReport[]

  @@index([communityId, lastMessageAt])
  @@index([channelId, lastMessageAt])
}

/// One `@handle` in a message's text that resolved to a real, eligible
/// user when it was sent (a community member who wasn't suspended).
/// Resolved server-side from the text itself — never trusted from the
/// client — and stored with its position so rendering doesn't re-parse
/// (and so a later handle change can't re-point an old mention).
model MessageMention {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageMentions", fields: [userId], references: [id], onDelete: Cascade)
  /// UTF-16 offset/length of the "@handle" inside Message.content.
  start     Int
  length    Int
  createdAt DateTime @default(now())

  @@unique([messageId, start])
  @@index([userId])
}

/// One user's reaction with one emoji on one message. The unique key is
/// the dedupe: set-on / set-off requests are idempotent, so double taps
/// and concurrent reactions can't produce duplicates.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// The in-game name a player last typed when registering for a game, so the
/// registration form can pre-fill it next time. One per player per game.
model UserGameName {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
}

/// An organizer's announcement on their tournament's page ("room details
/// are in the community", "start pushed back 30 minutes"). Registrants are
/// notified when one is posted. Plain text, written by the organizer only.
model TournamentUpdate {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("TournamentUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime   @default(now())

  @@index([tournamentId, createdAt])
}

enum DirectChallengePolicy {
  ANYONE
  FRIENDS
  NOBODY
}

/// One player blocking another. It stops friend requests and direct
/// challenges between them in both directions, hides the blocked player's
/// chat messages from the blocker, and keeps them out of each other's
/// Quick Match requests. Matches and disputes already under way are not
/// affected. See src/lib/blocks.ts.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// What a Marketplace listing sells. SERVICE = a player/coach's time or skill
/// (coaching, team spots, edits); DIGITAL = a platform-run or creator-made
/// digital good (cosmetics, gift cards, guides); ITEM = in-game items,
/// currency or accounts between players; STORE = organizer/brand goods
/// (merch, entry bundles, passes).
enum ListingCategory {
  SERVICE
  DIGITAL
  ITEM
  STORE
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  REMOVED
}

/// A thing for sale on the Marketplace. First slice: listing and browsing
/// only. Price is kobo like every other amount in the app. There is no
/// checkout yet; that (wallet payment held in escrow until delivery) is the
/// next slice, so nothing here moves money.
model Listing {
  id          String          @id @default(cuid())
  sellerId    String
  seller      User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    ListingCategory
  title       String
  description String
  /// Optional: which game this relates to (free text matching Game.name).
  game        String?
  priceKobo   Int
  imageUrl    String?
  /// Units left; null = unlimited (services, digital goods). Each paid order
  /// takes one; at zero the listing flips to SOLD.
  stock       Int?
  /// What the buyer must tell us at checkout (e.g. "Your in-game name"),
  /// so the order can be delivered. Null = nothing needed.
  buyerPrompt String?
  /// Where the file lives (an ebook hosted elsewhere, so it never sits in our
  /// storage). When set, an order is delivered the moment it is paid and the
  /// buyer downloads through an authenticated route; the raw link is never
  /// sent to the page or to anyone who hasn't bought.
  deliveryUrl String?
  /// Staff pick: shown in the Marketplace home hero and its Featured row.
  featured    Boolean         @default(false)
  status      ListingStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orders Order[]

  @@index([status, category, createdAt])
  @@index([sellerId, status])
}

/// PAID = money taken from the buyer's wallet, awaiting delivery by Circuit;
/// FULFILLED = delivered (with a note the buyer can read); CANCELLED =
/// refunded to the wallet.
enum OrderStatus {
  /// Paid by card and waiting for the provider to confirm; the unit is held until `reservedUntil`.
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum OrderPaymentMethod {
  WALLET
  CARD
}

/// One Marketplace purchase. Title/category/price are copied at purchase so
/// editing or removing the listing later never rewrites history.
model Order {
  id              String                   @id @default(cuid())
  listingId       String
  listing         Listing                  @relation(fields: [listingId], references: [id])
  buyerId         String
  buyer           User                     @relation(fields: [buyerId], references: [id])
  listingTitle    String
  category        ListingCategory
  amountKobo      Int
  /// The buyer's answer to the listing's `buyerPrompt`.
  buyerNote       String?
  status          OrderStatus              @default(PAID)
  /// Circuit's delivery message (a code, a link, instructions) or the reason
  /// for a cancellation. Shown to the buyer.
  fulfilmentNote  String?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?
  /// How it was paid. A wallet order is debited at once; a card order starts PENDING_PAYMENT.
  paymentMethod   OrderPaymentMethod       @default(WALLET)
  paymentProvider PaymentProviderName?
  /// The provider's charge reference for a card order. Unique, so a payment can only ever belong to one order.
  paymentRef      String?                  @unique
  /// A card order's unit is held until this time; if the payment has not been confirmed by then it is released.
  reservedUntil   DateTime?
  /// A card order that was cancelled is refunded to the card, not the wallet: the refund's reference and progress.
  refundRef       String?                  @unique
  refundStatus    WalletTransactionStatus?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservedUntil])
  @@index([listingId])
}

/// Where a stream is hosted. CIRCUIT is reserved for streams Circuit runs itself later; it is not offered yet.
enum StreamPlatform {
  TWITCH
  YOUTUBE
  KICK
  OTHER
  CIRCUIT
}

/// How a tournament is broadcast on Circuit.
enum StreamMode {
  TOURNAMENT_AND_PLAYERS
  TOURNAMENT_ONLY
  PLAYERS_ONLY
  NONE
}
