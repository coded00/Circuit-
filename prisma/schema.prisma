// Circuit — V1 data model
// Conceptual source: Circuit PRD, section 14 (Data Model)
// https://claude.ai/code/artifact/f568d35d-e93e-4205-9242-6a70c3a99d90
//
// This is a real schema derived from that conceptual model, built for task
// P0-1 in the Circuit Build Plan:
// https://claude.ai/code/artifact/a4a8a76e-68a5-4d50-b710-cda50106af8b

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  LIVE
  COMPLETE
  CANCELLED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WITHDRAWN
  REFUNDED
}

enum MatchStatus {
  UPCOMING
  NEEDS_RESULT
  DISPUTED
  COMPLETE
}

enum DisputeStatus {
  OPEN
  ORGANIZER_REVIEW
  ESCALATED
  RESOLVED
  VOID
}

enum EscrowType {
  ENTRY_FEE
  REFUND
  PRIZE_PAYOUT
  /// One row per player, created the moment their side of a Battle's
  /// stake is locked (creator at Battle creation, accepter at accept).
  STAKE
  /// Created once, to the match winner, for the full pot (both players'
  /// STAKE amounts) when a staked Battle's match completes.
  STAKE_PAYOUT
  /// Circuit's own cut, carved out of an entry fee the moment it's
  /// confirmed — see PlatformSetting.platformFeeBps. Recorded alongside
  /// the ENTRY_FEE row for the same registration, same amount charged to
  /// the player either way: this doesn't change what anyone pays, only
  /// how the money that already arrived is allocated in the ledger.
  PLATFORM_FEE
}

enum EscrowStatus {
  PENDING
  COMPLETE
  FAILED
}

enum PaymentProviderName {
  PAYSTACK
  FLUTTERWAVE
}

enum BattleVisibility {
  /// Visible to everyone on the open Challenge board.
  OPEN
  /// Visible only to one named player (`Battle.targetUserId`).
  TARGETED
  /// Visible only to the creator's accepted friends (`Friendship`) — any
  /// of them can accept, not just one. See `src/lib/friends.ts`.
  FRIENDS
}

enum BattleStatus {
  OPEN
  ACCEPTED
  CANCELLED
  COMPLETE
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Core identity. Maps to ACC-1..ACC-6.
/// Account creation is deferred (D4) — a User row is only created at
/// register-with-intent-to-pay, Battle accept, or payout claim.
model User {
  id                String     @id @default(cuid())
  displayName       String
  handle            String     @unique
  emailOrPhone      String     @unique
  passwordHash      String?
  avatarUrl         String?
  /// Short public profile tagline (ACC-6 profile edit) — free text,
  /// entirely optional, never used anywhere else in the app.
  bio               String?
  /// Free-text city/state/country — same optional-profile-field convention
  /// as bio. Not shown anywhere yet; exists so Player Discovery's region
  /// filter (a later phase) has real values to query instead of starting
  /// from zero once that filter ships.
  region            String?
  /// Self-curated list of games shown on the public profile — player-typed
  /// free text, not derived from real match history and NOT sourced from
  /// the `Game` catalog the way Tournament.game/Battle.game are: a
  /// player's "games I play" is a personal claim, not a real competition,
  /// so it isn't constrained to what organizers can actually host.
  favoriteGames     String[]   @default([])
  dateOfBirth       DateTime?
  ageVerified       Boolean    @default(false)
  /// P0-7: linked payout destination — what REG-6's payout actually pays out to.
  payoutMethodRef   String?
  /// Real, validated email — separate from `emailOrPhone` above, which may
  /// hold a phone number instead and was never format-checked at signup.
  /// Only ever set through Account Settings' own validation. Nullable:
  /// nobody is required to add one, they just don't get the email side of
  /// notifyNewContent below until they do.
  email             String?    @unique
  /// Single opt-out switch for "new tournament/challenge" broadcast
  /// announcements (email + push only — in-app notifications are always-on
  /// regardless, per InAppChannel's own comment in notifications.ts).
  /// Defaults to on so a real audience exists for the feature at all.
  notifyNewContent  Boolean    @default(true)
  /// Set once this user's browser subscribes via OneSignal. Not the
  /// broadcast targeting mechanism (that uses OneSignal's own "Subscribed
  /// Users" segment) — kept mainly for future debugging/visibility.
  oneSignalPlayerId String?
  /// P6-1/P6-2/P6-4: Circuit staff access — dispute-queue escalation
  /// ruling, account suspension. No self-serve grant path exists yet;
  /// setting this currently means a direct DB write, which is fine at V1's
  /// staffing size but is itself worth flagging as a gap.
  isStaff           Boolean    @default(false)
  /// Only meaningful when `isStaff` is true — which of the two fixed
  /// admin roles this staff account has. Null for an ordinary player.
  /// See `AdminRole`'s own comment for what each role can actually do.
  adminRole         AdminRole?
  /// P6-4/TRU-4: blocks registering, paying, or accepting Battles —
  /// checked at those specific write actions, never at login or browsing
  /// (same "don't touch the read path" discipline as the age gate, TRU-5).
  isSuspended       Boolean    @default(false)
  suspensionReason  String?
  /// Real, spendable Circuit balance (kobo) — funded via Fund Wallet,
  /// spent on entry fees, cashed out via Withdraw. The authoritative
  /// running total; `WalletTransaction` below is the immutable ledger
  /// that justifies it, kept in sync in the same DB transaction as every
  /// balance change so the two can never drift apart.
  walletBalance     Int        @default(0)
  createdAt         DateTime   @default(now())

  organizerProfile     OrganizerProfile?
  registrations        Registration[]
  matchesAsPlayerA     Match[]              @relation("MatchPlayerA")
  matchesAsPlayerB     Match[]              @relation("MatchPlayerB")
  matchesWon           Match[]              @relation("MatchWinner")
  battlesCreated       Battle[]             @relation("BattleCreator")
  battlesTargeted      Battle[]             @relation("BattleTarget")
  disputesRaised       Dispute[]            @relation("DisputeRaisedBy")
  notifications        Notification[]
  reportsFiled         Report[]             @relation("ReportFiledBy")
  reportsReceived      Report[]             @relation("ReportAgainstUser")
  communityPosts       CommunityPost[]      @relation("CommunityPostAuthor")
  passwordResetTokens  PasswordResetToken[]
  walletTransactions   WalletTransaction[]
  auditLogEntries      AuditLogEntry[]
  friendshipsSent      Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]         @relation("FriendshipAddressee")
  teamsCaptained       Team[]               @relation("TeamCaptain")
  teamMemberships      TeamMembership[]
  escrowTransactions   EscrowTransaction[]
  videoLikes           VideoLike[]
  videoSaves           VideoSave[]
  communityMemberships CommunityMember[]
  messages             Message[]

  @@index([emailOrPhone])
}

/// The admin dashboard's two fixed roles (no per-permission matrix — a
/// bigger system than a V1 staffing size of "a handful of people"
/// justifies). SUPER_ADMIN can do everything MODERATOR can, plus manage
/// other staff accounts (grant/revoke access, change roles) and toggle
/// platform-wide settings; MODERATOR covers day-to-day moderation
/// (suspend/unsuspend users, cancel tournaments, manage homepage content
/// and the calendar) but can't touch who else has admin access. Checked
/// in each admin API route directly (see e.g. `/api/admin/settings`),
/// not via a separate middleware layer.
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum WalletTransactionType {
  /// Real money in, via Paystack/Flutterwave checkout.
  FUND
  /// Real money out, via Paystack/Flutterwave transfer to payoutMethodRef.
  WITHDRAWAL
  /// A tournament entry fee paid straight from the wallet balance instead
  /// of a fresh external checkout — internal only, no provider touched
  /// for this specific transaction (the money already arrived at some
  /// earlier FUND). A real `EscrowTransaction(type: ENTRY_FEE)` row is
  /// still created alongside this one, same as an externally-paid entry
  /// fee, so tournament-side accounting (dashboard/payouts) sees no
  /// difference in how the fee was funded.
  ENTRY_FEE_DEBIT
  /// A Battle stake locked from the wallet balance — see `EscrowType.STAKE`.
  /// Always wallet-only, same "no provider touched" reasoning as
  /// ENTRY_FEE_DEBIT: a stake can only ever be funded from an existing
  /// wallet balance, never a fresh external checkout.
  STAKE_DEBIT
  /// Any wallet credit that resolves a Battle stake — winning the pot
  /// (`EscrowType.STAKE_PAYOUT`) or getting a stake back from a voided
  /// match (`EscrowType.REFUND`). One wallet-ledger type for both; the
  /// paired `EscrowTransaction.type` is what distinguishes why. Unlike a
  /// tournament prize (paid out externally via `payoutMethodRef`), a
  /// Battle stake always resolves straight back into the wallet — no
  /// organizer/claim flow for a peer-to-peer pot.
  STAKE_CREDIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETE
  FAILED
}

/// The wallet's immutable ledger. `User.walletBalance` is the derived
/// running total; every change to it happens in the same DB transaction
/// as the row here that justifies it.
model WalletTransaction {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  type        WalletTransactionType
  /// Minor currency units (kobo). Always positive — `type` gives direction.
  amount      Int
  /// Null for ENTRY_FEE_DEBIT — no external provider is touched for that
  /// specific transaction.
  provider    PaymentProviderName?
  providerRef String?                 @unique
  status      WalletTransactionStatus @default(PENDING)
  createdAt   DateTime                @default(now())

  @@index([userId, status])
}

/// Forgot-password flow. Only `tokenHash` (SHA-256 of the raw token) is
/// stored — the raw token exists only in the reset link/email, same
/// "never store the secret itself" discipline as `passwordHash` on User.
/// Single-use: `usedAt` is set the moment a reset succeeds, and the reset
/// route rejects any token that's expired, already used, or unknown.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// 1:1 with User, created automatically on that user's first tournament (ACC-4).
/// Not a separate signup — see D4 and the PRD's Users & Roles section.
model OrganizerProfile {
  userId      String       @id
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean      @default(false)
  tournaments Tournament[]
}

/// Maps to TRN-1..TRN-6.
/// Admin-curated catalog of games organizers can pick from when creating a
/// tournament or challenge (see Tournament.game / Battle.game) — Admin >
/// Games manages these rows. Deliberately not a foreign key: Tournament.game
/// and Battle.game stay plain strings so every existing row and every read
/// site that already treats `game` as a string keeps working unchanged —
/// this table only constrains what the *creation/edit forms* offer as
/// options, not what's already stored or how it's queried elsewhere.
model Game {
  id        String   @id @default(cuid())
  name      String   @unique
  iconUrl   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([enabled])
}

model Tournament {
  id                  String           @id @default(cuid())
  organizerId         String
  organizer           OrganizerProfile @relation(fields: [organizerId], references: [userId])
  name                String
  /// Free text, not a foreign key to `Game` — see that model's comment.
  /// Populated from an admin-curated `Game.name` list via the creation/
  /// edit form's `<select>`, not hand-typed.
  game                String
  /// V1 is knockout-only (D2). Kept as a string, not an enum, so V2 formats
  /// (round-robin, league) don't require a migration to add.
  format              String           @default("KNOCKOUT")
  /// How many players face off per side of a bracket match — "1v1"
  /// through "5v5". Organizer-set at creation (real match-format research:
  /// e.g. Call of Duty Mobile alone runs 5v5 in ranked multiplayer but
  /// solo/duo in Tournament Mode — team size is a property of the specific
  /// competition, not the game). Kept as a string, not derived from
  /// `game`, for the same reason `game` itself isn't a hard foreign key.
  /// Real limitation, not silently glossed over: this is a descriptive
  /// label only. `Registration` still links exactly one `User` per row —
  /// Circuit has no team/roster model, so a "5v5" tournament still means
  /// five individual people each register solo and coordinate as a team
  /// outside the platform. Bracket matches themselves are always a real
  /// 1-vs-1 `Match` row regardless of teamSize.
  teamSize            String           @default("1v1")
  /// Minor currency units (kobo), never a float. 0 = free tournament.
  entryFee            Int              @default(0)
  prizeAmount         Int?
  prizeText           String?
  rulesText           String?
  /// Just a link (Twitch/YouTube/anything) — no embed, no live-status
  /// check. Full streaming integration is a documented V2 item (PRD's
  /// Fraud & Trust backlog note on "live proctoring... bundled with the
  /// streaming build-out"); this is the lightweight V1 slice of it.
  streamUrl           String?
  /// The organizer's own real poster/banner for this specific tournament
  /// — a pasted URL, not a file upload (Circuit has no object-storage/CDN
  /// upload pipeline anywhere, same "paste a URL" convention as
  /// HomepageBanner.imageUrl/User.avatarUrl). Null falls back to
  /// GameArtTile's generic per-game stock photo/gradient (see that
  /// component's own comment) rather than a broken image.
  posterUrl           String?
  participantCap      Int
  registrationOpenAt  DateTime
  registrationCloseAt DateTime
  startAt             DateTime
  status              TournamentStatus @default(DRAFT)
  /// Admin financial control (V1 audit's fund-freeze requirement) — set
  /// via POST/DELETE /api/tournaments/[id]/freeze-funds, requireStaff()
  /// gated. Blocks the prize-payout claim and cancel-with-refund routes
  /// while true; who froze it, when, and why lives in AuditLogEntry
  /// (action "tournament.freezeFunds"/"tournament.unfreezeFunds") rather
  /// than duplicating actor/reason/timestamp fields here — same "reuse
  /// the existing audit log" reasoning as every other admin action.
  fundsFrozen         Boolean          @default(false)
  createdAt           DateTime         @default(now())

  registrations Registration[]
  bracket       Bracket?
  matches       Match[]
  escrowTxns    EscrowTransaction[]
  videos        Video[]
  community     Community?

  @@index([game, status])
}

/// Links a User to a Tournament. Maps to REG-1..REG-7.
model Registration {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  status       RegistrationStatus @default(PENDING_PAYMENT)
  /// REG-1's minimum organizer-required field. Display name comes from the
  /// linked User (see ORG-5's CSV export) — in-game ID doesn't live there
  /// since it's per-tournament, not identity.
  inGameId     String
  /// Our own reference (not the provider's), generated at P2-2's charge
  /// init and echoed back by both PaymentProviderClient implementations —
  /// what a webhook looks up a Registration by.
  paymentRef   String?            @unique
  createdAt    DateTime           @default(now())

  escrowTxns EscrowTransaction[]

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
}

/// 1:1 with Tournament. Maps to BRK-1.
model Bracket {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  generatedAt  DateTime   @default(now())
  /// Rounds & seeding — kept as JSON at this stage; promote specific fields
  /// to columns only if a query needs to filter on them directly.
  structure    Json
}

/// Belongs to a Tournament+Bracket OR a Battle — never both.
/// Enforced at the application layer (see src/lib/matches — not yet built,
/// this is scaffolding only); Postgres CHECK constraint is worth adding in
/// a migration once the app-layer invariant is proven out.
/// Maps to BRK-2..BRK-10 and BTL-4.
model Match {
  id           String      @id @default(cuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  battleId     String?
  battle       Battle?     @relation(fields: [battleId], references: [id])
  round        Int?

  /// BRK-9: per-match code shown to both players before they play; must
  /// appear in submitted proof to bind that proof to this specific match.
  matchCode String @unique

  playerAId String
  playerA   User   @relation("MatchPlayerA", fields: [playerAId], references: [id])
  playerBId String
  playerB   User   @relation("MatchPlayerB", fields: [playerBId], references: [id])

  status    MatchStatus @default(UPCOMING)
  resultA   Json?
  resultB   Json?
  proofARef String?
  proofBRef String?

  winnerId String?
  winner   User?   @relation("MatchWinner", fields: [winnerId], references: [id])

  /// Battle matches only (see the "Enter Match" flow): when each player
  /// confirmed they're heading into the actual game. Null/null right
  /// after acceptance; both non-null means the match is genuinely live.
  /// UI-only signal — never gates result submission at the API level, so
  /// a stuck "enter" click can never block someone from actually
  /// reporting a real result. Meaningless once a result exists.
  playerAReadyAt DateTime?
  playerBReadyAt DateTime?

  /// BRK-10: silent-side auto-accept deadline once one side has reported.
  reportWindowExpiresAt DateTime?
  createdAt             DateTime  @default(now())

  dispute Dispute?

  @@index([tournamentId])
  @@index([battleId])
  @@index([status])
}

/// Created by a User. Maps to BTL-1..BTL-6.
model Battle {
  id           String           @id @default(cuid())
  creatorId    String
  creator      User             @relation("BattleCreator", fields: [creatorId], references: [id])
  /// Same "admin-curated `Game.name`, not a foreign key" convention as
  /// Tournament.game — see that field's comment.
  game         String
  /// "SINGLE" | "BEST_OF_3" — kept as string for the same reason as
  /// Tournament.format above.
  format       String
  visibility   BattleVisibility @default(OPEN)
  targetUserId String?
  targetUser   User?            @relation("BattleTarget", fields: [targetUserId], references: [id])
  /// Kobo. 0 = free (still the vast majority of Battles). Above zero,
  /// this is locked from the creator's wallet at creation and matched
  /// from the accepter's at accept — see `EscrowType.STAKE`. Core escrow
  /// mechanics only (see `EscrowTransaction`'s own comment on what's
  /// deliberately not built yet).
  stakeAmount  Int              @default(0)
  /// Same lightweight link-only field as Tournament.streamUrl — see that
  /// field's comment.
  streamUrl    String?
  status       BattleStatus     @default(OPEN)
  createdAt    DateTime         @default(now())

  matches    Match[]
  escrowTxns EscrowTransaction[]

  @@index([game, status])
}

/// Belongs to a Match. Maps to BRK-5, BRK-6, TRU-1..TRU-2.
model Dispute {
  id                      String        @id @default(cuid())
  matchId                 String        @unique
  match                   Match         @relation(fields: [matchId], references: [id])
  raisedById              String
  raisedBy                User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  status                  DisputeStatus @default(OPEN)
  /// BRK-5's 24h (placeholder) window: the organizer must rule by this
  /// time or the sweep (P3-6/BRK-6) escalates to the Phase 6 staff queue.
  /// Null for a Battle dispute or one escalated immediately (organizer is
  /// a disputant) — there's no organizer-review phase to time out.
  organizerRulingDeadline DateTime?
  ruling                  String?
  ruledById               String?
  ruledAt                 DateTime?
  createdAt               DateTime      @default(now())

  @@index([status])
}

/// Belongs to a Tournament (with an optional Registration) OR a Battle
/// (with a User) — exactly one of tournamentId/battleId is set, same
/// app-layer-enforced "exactly one owner" convention as Match's own
/// tournamentId/battleId pair (no DB CHECK constraint). Maps to REG-2,
/// REG-5, REG-6, ORG-4 (tournament side) and BTL-1..BTL-6 (Battle stake
/// side — core escrow mechanics only: no per-account stake limits,
/// collusion detection, or self-exclusion tooling yet, so this does not
/// meet the bar docs/circuit-strategy.md sets for a launched, legally-
/// reviewed staked-Battles feature. Shipped as the underlying mechanism
/// only, per explicit product decision.)
model EscrowTransaction {
  id             String               @id @default(cuid())
  tournamentId   String?
  tournament     Tournament?          @relation(fields: [tournamentId], references: [id])
  registrationId String?
  registration   Registration?        @relation(fields: [registrationId], references: [id])
  /// Set only for a Battle-stake row (STAKE/STAKE_PAYOUT/REFUND on a
  /// Battle) — who paid a STAKE or received a STAKE_PAYOUT/REFUND. Always
  /// null on the tournament side, where `registration.userId` already
  /// answers this.
  battleId       String?
  battle         Battle?              @relation(fields: [battleId], references: [id])
  userId         String?
  user           User?                @relation(fields: [userId], references: [id])
  type           EscrowType
  /// Minor currency units (kobo).
  amount         Int
  /// Null for a Battle-stake row — wallet-balance-only, no external
  /// provider touched (same reasoning as `WalletTransactionType.
  /// STAKE_DEBIT`/`STAKE_PAYOUT_CREDIT`).
  provider       PaymentProviderName?
  /// Unique like WalletTransaction.providerRef — a duplicate provider
  /// reference (a literal webhook replay, or two writes racing to record
  /// the same transfer/charge) fails at the DB, not just in application
  /// logic. Multiple NULLs are fine (Postgres doesn't treat them as
  /// duplicates) — only set once a provider call actually returns one.
  providerRef    String?              @unique
  status         EscrowStatus         @default(PENDING)
  createdAt      DateTime             @default(now())

  @@index([tournamentId, type])
  @@index([battleId, type])
}

/// Belongs to a User. Maps to NOT-1..NOT-4.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Belongs to a User. New for the community-feed rebuild (not in the
/// original PRD's requirement numbering) — a public, unmoderated-beyond-
/// Report post feed. No likes/comments yet (deferred as a smaller,
/// separately-scoped follow-up). The feed's Friends/Teams tabs filter
/// this same table by `Friendship`/`TeamMembership` — see those models.
model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("CommunityPostAuthor", fields: [authorId], references: [id])
  /// Plain text, length-capped (see parseCommunityPostContent) — no rich
  /// text, no image attachment (an attachment would need either the
  /// private HMAC-signed proof storage repurposed for public reads, or a
  /// second storage path — real scope this request didn't ask for).
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Belongs to two Users (directed: requester → addressee). One row covers
/// the whole lifecycle — a pending request becomes `accepted: true` on
/// acceptance; declining a request, cancelling one you sent, or
/// unfriending an accepted one all just delete the row, so there's no
/// separate DECLINED state to reason about or clean up later. Powers the
/// Friends tabs on the community feed, ladder, and homepage leaderboard —
/// see `src/lib/friends.ts`.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, accepted])
  @@index([requesterId, accepted])
}

/// A persistent squad — name, optional tag, a roster, one captain.
/// Deliberately NOT wired into tournament/challenge registration:
/// `Registration` stays one row per individual `User` (see that model's
/// own comment) — a `Team` here is a social grouping only, not a new
/// registration unit. The captain leaves by disbanding the team (there's
/// no captaincy-transfer flow); anyone else just leaves their own
/// `TeamMembership` row.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String?
  /// Free text, same convention as Tournament.game/Battle.game/
  /// User.favoriteGames — not a Game-catalog foreign key. Added for
  /// Player & Team Discovery Phase 3: without this, "browse teams by
  /// game" has nothing real to filter on. Optional — a team can exist
  /// before its captain sets one.
  game      String?
  /// Free text city/state/country, same convention as User.region.
  region    String?
  captainId String
  captain   User     @relation("TeamCaptain", fields: [captainId], references: [id])
  createdAt DateTime @default(now())

  members TeamMembership[]
}

/// One row per (team, user) pair, including the captain's own membership
/// (created alongside the `Team`). `accepted: false` is a pending invite
/// the invited user hasn't responded to yet — same "no separate DECLINED
/// state" convention as `Friendship`: declining an invite, leaving, and
/// being removed all just delete the row.
model TeamMembership {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  accepted          Boolean  @default(false)
  /// Distinguishes who started this pending row, since `accepted: false`
  /// now means either direction (Discovery Phase 3): false (default) is
  /// the original captain-invites-a-handle flow (the invited user
  /// accepts); true is a player requesting to join a team found via
  /// Discovery (the captain accepts). Same row shape, different
  /// permission check on whoever's allowed to flip `accepted`.
  requestedByMember Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId, accepted])
}

/// Belongs to a reported User. Maps to TRU-3.
model Report {
  id             String       @id @default(cuid())
  reportedUserId String
  reportedUser   User         @relation("ReportAgainstUser", fields: [reportedUserId], references: [id])
  reportedById   String
  reportedBy     User         @relation("ReportFiledBy", fields: [reportedById], references: [id])
  reason         String
  /// Optional evidence upload (TRU-3) — reuses proofStorage (src/lib/
  /// storage.ts), keyed by this report's own id rather than a matchId;
  /// that storage interface only ever cared about an opaque string key.
  evidenceRef    String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@index([reportedUserId, status])
}

// ---------------------------------------------------------------------------
// Admin dashboard (Content / Calendar / Settings) — Phase 5.
// ---------------------------------------------------------------------------

/// One slide in the homepage hero carousel — admin-authored, real content
/// `CircuitHero` renders alongside its own real tournament-spotlight
/// slides (see that component's own comment). `imageUrl` is a plain URL
/// field, not a file upload: Circuit has no object-storage/CDN upload
/// pipeline anywhere in the codebase (avatarUrl/streamUrl are the same
/// "paste a URL" shape), and standing one up wasn't part of this request.
model HomepageBanner {
  id          String    @id @default(cuid())
  headline    String
  description String?
  imageUrl    String
  ctaLabel    String?
  ctaHref     String?
  /// Lower sorts first. Admin-set via reordering, not auto-computed.
  order       Int       @default(0)
  enabled     Boolean   @default(true)
  /// Null = publish immediately once enabled. In the future = scheduled,
  /// not yet shown on the real homepage.
  publishAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([enabled, order])
}

/// A site-wide notice — real content the homepage renders in a small
/// dismissible strip when at least one row is enabled (most recent wins;
/// see `getActiveAnnouncement`). No targeting/scheduling — same "keep it
/// minimal" instruction the whole admin build follows.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([enabled, createdAt])
}

/// The two categories the player calendar's own "Community"/"Game
/// Releases" tabs were left disabled for (see src/app/calendar/page.tsx's
/// header comment) — Tournaments and Challenges are still derived
/// entirely from real `Tournament`/`Battle` rows, never admin-authored
/// here, since inventing a "competition" that isn't a real tournament
/// would break that page's whole real-data discipline.
enum CalendarEventCategory {
  COMMUNITY
  GAME_RELEASE
}

model CalendarEvent {
  id        String                @id @default(cuid())
  title     String
  category  CalendarEventCategory
  date      DateTime
  cancelled Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([category, date])
}

/// Singleton row (`id` is always "singleton") — real platform-wide
/// toggles. Deliberately just the one real, meaningful setting
/// (maintenance mode) rather than a grab-bag of unused fields invented to
/// look complete; see `/admin/settings`'s own comment.
model PlatformSetting {
  id              String  @id @default("singleton")
  maintenanceMode Boolean @default(false)
  /// Circuit's cut of every paid tournament entry, in basis points (1/100
  /// of a percent — 500 = 5.00%) rather than a plain integer percent, so
  /// a future rate change never needs a fractional-percent migration.
  /// Admin-configurable (Admin > Settings), not a code constant, on
  /// purpose: the exact rate is a business decision that can change
  /// without a deploy — see PlatformFeeControl.tsx. Applied only to new
  /// entry-fee confirmations going forward; changing it never rewrites
  /// already-recorded PLATFORM_FEE escrow rows.
  platformFeeBps  Int     @default(500)
}

/// Every real write an admin makes anywhere in `/admin` appends one row
/// here — Settings > Audit Log reads this back, nothing else. `metadata`
/// is intentionally loose (Json) since each action logs different
/// details (a suspension reason, a role change's before/after, etc.).
model AuditLogEntry {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// V1 rate limiting (ACC-5) — a small attempts table queried per request,
/// not Redis; see docs/circuit-stack.md's Rate limiting section for why
/// ("does the same job at V1's actual traffic without standing up a new
/// service" — Upstash Redis is the named upgrade path if that ever stops
/// being true). `key` scopes an attempt to both the action and the
/// identifier it's against (e.g. "login:user@example.com"), so this one
/// table covers every rate-limited route without a migration per route.
/// Self-cleaning, not swept by a cron job — see src/lib/rateLimit.ts.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// Video Feed (Circuit Video Feed spec, Phase 1 — foundation)
// ---------------------------------------------------------------------------

enum VideoSource {
  CIRCUIT
  YOUTUBE
}

enum VideoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Unified model so Circuit-managed clips and (Phase 3) official YouTube
/// gaming Shorts can appear in the same feed. `game` follows the same
/// free-text convention as `Tournament.game`/`Battle.game` (not a foreign
/// key to the admin `Game` catalog — see that model's comment), so a video
/// can reference any real game name without depending on catalog upkeep.
/// `tournamentId` is optional and only ever set for Circuit-managed
/// highlight/announcement clips tied to a real tournament.
model Video {
  id           String      @id @default(cuid())
  /// Stable, URL-safe identifier for `/videos/[slug]` deep links — derived
  /// from `title` at creation, not user-editable.
  slug         String      @unique
  source       VideoSource @default(CIRCUIT)
  title        String
  description  String?
  /// Directly playable file — required for `source: CIRCUIT`, null for
  /// `source: YOUTUBE` (Phase 3 plays those via the official embed instead).
  videoUrl     String?
  thumbnailUrl String?
  /// External canonical URL — required for `source: YOUTUBE` attribution,
  /// unused for Circuit-managed content.
  sourceUrl    String?
  sourceAuthor String?
  /// Free text, same convention as `Tournament.game` — see that field's
  /// comment above.
  game         String?
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  tags         String[]    @default([])
  likes        Int         @default(0)
  views        Int         @default(0)
  shares       Int         @default(0)
  status       VideoStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())

  likedBy VideoLike[]
  savedBy VideoSave[]

  @@index([status, publishedAt])
  @@index([game])
}

/// One row per (user, video) like — the duplicate-like guard the product
/// spec calls for. `Video.likes` is the fast denormalized counter, kept in
/// sync in the same transaction as this row's insert/delete.
model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

/// Same shape as `VideoLike`, for the "Save" interaction.
model VideoSave {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
}

// ---------------------------------------------------------------------------
// Circuit Community, Phase 1 — a Discord-style chat attached to one specific
// Tournament. Unrelated to `CommunityPost` above despite the name overlap:
// that model is a flat, global, Twitter-like public feed with no channels,
// no per-tournament scope, and no relation to any of the models below —
// don't conflate the two when reading either.
//
// Deliberately minimal for Phase 1 (validate whether people actually talk
// around a tournament before building reactions/roles/moderation nobody's
// asked for yet): one Community per Tournament, four fixed channels, plain
// text messages, join/leave, and a single last-read timestamp per member
// for a basic unread indicator. No real-time transport — messages are read
// via ordinary polling (see `Poller.tsx`'s own doc on why: no WebSocket
// infra exists, Vercel serverless can't hold one open anyway, and the
// stack docs already name Pusher/Ably as the escalation path if polling
// ever stops feeling live enough).
// ---------------------------------------------------------------------------

/// 1:1 with Tournament for a normal community — `enabled` is the
/// organizer's on/off switch (set at tournament creation or toggled
/// later from the edit form), and the row itself, once created, is never
/// deleted just by disabling, so re-enabling doesn't lose channel/
/// message history. `tournamentId` is nullable for exactly one
/// exception: the single platform-wide "Circuit" community every user
/// is auto-joined to at signup (`isGlobal: true`, no tournament at all).
/// Application code (`getOrCreateGlobalCommunity`), not a DB constraint,
/// is what keeps that singleton to one row — see that function's own
/// comment for why a schema-level constraint wasn't worth it at V1.
model Community {
  id           String      @id @default(cuid())
  tournamentId String?     @unique
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  isGlobal     Boolean     @default(false)
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now())

  channels Channel[]
  members  CommunityMember[]
}

/// The four fixed V1 channels (general/announcements/matches/results),
/// created together when a Community is enabled. `key` (not just `name`)
/// exists because Phase 3's auto-generated match/tournament event
/// messages need to target "the matches channel" and "the results
/// channel" programmatically by a stable identifier, not by matching on
/// a human-editable display name.
model Channel {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  key         String
  name        String
  createdAt   DateTime  @default(now())

  messages Message[]

  @@unique([communityId, key])
}

/// Join/leave membership — posting or reading requires a row here. A
/// single `lastReadAt` per member (not per-channel) is Phase 1's
/// deliberately basic unread signal: "anything new since I last opened
/// this community," not a per-channel read receipt.
model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime  @default(now())

  @@unique([communityId, userId])
}

/// Plain text only for Phase 1 — no attachments, no edit history. `isSystem`
/// is unused today (nothing sets it true yet) but exists so Phase 3's
/// auto-generated match/tournament event messages don't need a schema
/// change to be visually distinguished from a real user's message.
model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}
