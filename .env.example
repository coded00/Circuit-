# Copy this file to .env and fill in real values before running the app.
# Never commit .env — it's already in .gitignore.

# Postgres connection string. For local dev, the easiest options are:
#  - Docker: `docker run --name circuit-db -e POSTGRES_PASSWORD=circuit -p 5432:5432 -d postgres`
#  - A free hosted instance (Neon, Supabase, Railway) if you'd rather not run Postgres locally.
DATABASE_URL="postgresql://postgres:circuit@localhost:5432/circuit"

# Used to sign session tokens (src/lib/auth.ts). Generate one with:
#   openssl rand -base64 32
JWT_SECRET=""

# Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Flutterwave — https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# Set under Settings > Webhooks in the Flutterwave dashboard — a shared
# secret they echo back in the `verif-hash` header, not derived from
# FLUTTERWAVE_SECRET_KEY. Used by src/app/api/webhooks/flutterwave.
FLUTTERWAVE_SECRET_HASH=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — https://resend.com/api-keys. Used by src/lib/email.ts for the
# forgot-password flow (src/app/api/auth/forgot-password). Left unset, the
# reset link is logged to the server console instead of emailed — fine for
# local dev, not for production.
RESEND_API_KEY=""

# Shared secret for POST /api/cron/sweep (src/app/api/cron/sweep) — whatever
# scheduler calls it sends `Authorization: Bearer $CRON_SECRET`. Generate one
# with: openssl rand -base64 32
CRON_SECRET=""

# OneSignal — https://onesignal.com (create an app, get these from Settings >
# Keys & IDs). Used for real browser push on new tournaments/Challenges
# (src/lib/push.ts, src/components/OneSignalInit.tsx). Left unset, pushes are
# logged to the server console instead of sent — same degrade pattern as
# RESEND_API_KEY above. NEXT_PUBLIC_ONESIGNAL_APP_ID is exposed to the
# browser (it's the SDK's own app id, not a secret); ONESIGNAL_API_KEY is
# the REST API key and must stay server-only.
NEXT_PUBLIC_ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# YouTube Data API v3 — https://console.cloud.google.com. Create a project,
# enable "YouTube Data API v3" under APIs & Services, then Credentials >
# Create Credentials > API key. Public read-only key, no OAuth/login flow —
# only used by scripts/ingest-youtube.mjs (src/lib/youtube.ts) to list the
# curated channels' recent uploads (src/lib/youtube-channels.ts). Playback
# itself (the youtube.com/embed iframe) needs no key at all.
YOUTUBE_API_KEY=""

# Cloudflare R2 / AWS S3 (Match proof storage in serverless production)
# Left unset, storage falls back to local disk (storage/proof/).
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# PostHog — https://posthog.com (Settings > Project API Key). Used by
# src/lib/analytics.ts for product analytics. NEXT_PUBLIC_POSTHOG_KEY is
# exposed to the browser (it's PostHog's own public project key, not a
# secret); POSTHOG_KEY is an optional server-side fallback. Left unset,
# analytics calls are skipped. NEXT_PUBLIC_POSTHOG_HOST defaults to
# PostHog Cloud if unset.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Sentry — https://sentry.io (Settings > Client Keys (DSN)). Used by
# src/lib/observability.ts for error tracking. Left unset, errors are
# only logged to the server console.
SENTRY_DSN=""

