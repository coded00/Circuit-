# Copy this file to .env and fill in real values before running the app.
# Never commit .env — it's already in .gitignore.

# Postgres connection string. For local dev, the easiest options are:
#  - Docker: `docker run --name circuit-db -e POSTGRES_PASSWORD=circuit -p 5432:5432 -d postgres`
#  - A free hosted instance (Neon, Supabase, Railway) if you'd rather not run Postgres locally.
DATABASE_URL="postgresql://postgres:circuit@localhost:5432/circuit"

# Used only by `prisma migrate` (schema.prisma's directUrl). Prisma's
# migration lock doesn't survive a connection pooler, so migrations must
# connect directly. With Neon, use the same URL as DATABASE_URL with
# `-pooler` removed from the host; with a plain Postgres (no pooler), set
# it to exactly the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:circuit@localhost:5432/circuit"

# Used to sign session tokens (src/lib/auth.ts). Generate one with:
#   openssl rand -base64 32
JWT_SECRET=""

# Paystack — https://dashboard.paystack.com/#/settings/developer. Only the
# secret key is used (checkout is server-initiated hosted checkout, not a
# client-side inline widget) — there's no public key anywhere in the code.
PAYSTACK_SECRET_KEY=""

# Flutterwave — https://dashboard.flutterwave.com/settings/apis. Same
# server-initiated-checkout reasoning as Paystack above — no public key used.
FLUTTERWAVE_SECRET_KEY=""
# Set under Settings > Webhooks in the Flutterwave dashboard — a shared
# secret they echo back in the `verif-hash` header, not derived from
# FLUTTERWAVE_SECRET_KEY. Used by src/app/api/webhooks/flutterwave.
FLUTTERWAVE_SECRET_HASH=""

# Bachs (collections and refunds). Sandbox keys start sk_sandbox_, live keys sk_live_.
BACHS_API_KEY=""
# Signing secret of the webhook endpoint pointed at /api/webhooks/bachs.
BACHS_WEBHOOK_SECRET=""
# Routing. Charges go to the primary and fall back when it can't be reached. Payouts stay on Paystack.
# Leave unset until Bachs is tested: everything then runs on Paystack as before.
# PAYMENT_PRIMARY_PROVIDER=BACHS
# PAYMENT_FALLBACK_PROVIDER=PAYSTACK
# PAYMENT_PAYOUT_PROVIDER=PAYSTACK


NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in ("Continue with Google") — a Google Cloud OAuth 2.0 Client
# ID of type "Web application". Leave blank to hide the Google option; email
# sign-in works either way. The callback is derived from NEXT_PUBLIC_APP_URL:
# register <NEXT_PUBLIC_APP_URL>/api/auth/google/callback as an authorized
# redirect URI for each environment (see README → Google sign-in).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — https://resend.com/api-keys. Used by src/lib/email.ts for the
# forgot-password flow (src/app/api/auth/forgot-password). Left unset, the
# reset link is logged to the server console instead of emailed — fine for
# local dev, not for production.
RESEND_API_KEY=""
# Verified email is required before paid entry, staking, withdrawing and claiming a prize.
# Off until RESEND_API_KEY is set (no email can be sent without it); true/false forces it.
# REQUIRE_VERIFIED_EMAIL=

# Where the repeated-pair collusion sweep emails its alerts
# (src/lib/stakePatterns.ts). When the sweep finds two accounts whose staked
# Battles against each other look like a one-way transfer, it queues the pair
# at /admin/stakes AND emails this address — the in-app notification only
# reaches a staff member who happens to open the admin, and a flag nobody sees
# for a week is a flag that did nothing. Leave it unset and only the in-app
# fan-out happens (every isStaff account still gets the notification). Needs
# RESEND_API_KEY above to actually send.
# TRUST_SAFETY_EMAIL="trust@example.com"

# Shared secret for POST /api/cron/sweep (src/app/api/cron/sweep) — whatever
# scheduler calls it sends `Authorization: Bearer $CRON_SECRET`. Generate one
# with: openssl rand -base64 32
CRON_SECRET=""

# Reverse proxy (src/lib/rateLimit.ts's getClientIp). Rate limits on
# unauthenticated routes key on the caller's IP, and no IP header can be
# trusted on its own — a caller can set any of them. Set this to a value your
# proxy injects into `TRUSTED_PROXY_IP_HEADER` on every request; only then is
# that header believed. Generate one with: openssl rand -base64 32
# Without it, the app falls back to the last entry of X-Forwarded-For, which is
# correct for a single reverse proxy that appends (Caddy's default, nginx's
# $proxy_add_x_forwarded_for). See docs/pre-launch-checklist.md.
TRUSTED_PROXY_SECRET=""
# Which header the proxy puts the visitor's address in. Defaults to
# cf-connecting-ip (Cloudflare). Ignored unless TRUSTED_PROXY_SECRET is set.
# TRUSTED_PROXY_IP_HEADER="cf-connecting-ip"

# Self-hosted servers only (no Vercel Cron): where scripts/cron-sweep.mjs
# reaches the app. Defaults to http://localhost:$PORT (3000) — leave unset
# when the runner is on the same machine. See docs/self-hosting.md.
# SWEEP_URL="http://localhost:3000"

# OneSignal — https://onesignal.com (create an app, get these from Settings >
# Keys & IDs). Used for real browser push on new tournaments/Challenges
# (src/lib/push.ts, src/components/OneSignalInit.tsx). Left unset, pushes are
# logged to the server console instead of sent — same degrade pattern as
# RESEND_API_KEY above. NEXT_PUBLIC_ONESIGNAL_APP_ID is exposed to the
# browser (it's the SDK's own app id, not a secret); ONESIGNAL_API_KEY is
# the REST API key and must stay server-only.
NEXT_PUBLIC_ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# YouTube Data API v3 — https://console.cloud.google.com. Create a project,
# enable "YouTube Data API v3" under APIs & Services, then Credentials >
# Create Credentials > API key. Public read-only key, no OAuth/login flow —
# only used by scripts/ingest-youtube.mjs (src/lib/youtube.ts) to list the
# curated channels' recent uploads (src/lib/youtube-channels.ts). Playback
# itself (the youtube.com/embed iframe) needs no key at all.
YOUTUBE_API_KEY=""

# Twitch API — https://dev.twitch.tv/console/apps. Register an application (category: Website Integration), copy its
# Client ID and generate a Client Secret. App credentials only, no viewer login. Used by Circuit Watch to show which
# Twitch channels are live and how many are watching. Left unset, Watch simply shows no live badges. Live badges for
# YouTube streams (a video link) use YOUTUBE_API_KEY above.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Cloudflare R2 / AWS S3 (Match proof storage in serverless production, see
# src/lib/storage.ts's createProofStorage). Left unset, storage falls back
# to local disk (storage/proof/). R2_ENDPOINT can be omitted if
# R2_ACCOUNT_ID is set (derived as https://<account>.r2.cloudflarestorage.com).
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_REGION=""
# Generic S3-compatible fallbacks — only read when the R2_* equivalent
# above is unset, for pointing this at a real AWS S3 bucket (or any other
# S3-compatible provider) instead of R2 without renaming env vars.
S3_BUCKET=""
S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# PostHog — https://posthog.com (Settings > Project API Key). Used by
# src/lib/analytics.ts for product analytics. NEXT_PUBLIC_POSTHOG_KEY is
# exposed to the browser (it's PostHog's own public project key, not a
# secret); POSTHOG_KEY is an optional server-side fallback. Left unset,
# analytics calls are skipped. NEXT_PUBLIC_POSTHOG_HOST defaults to
# PostHog Cloud if unset.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Sentry — https://sentry.io (Settings > Client Keys (DSN)). Used by
# src/lib/observability.ts for error tracking. Left unset, errors are
# only logged to the server console.
SENTRY_DSN=""

